@{
    ViewData["Title"] = "Zahtjevi profesora";
    Layout = null;
    var zahtjevi = ViewBag.Zahtjevi as List<ZamETF.Models.Obavijest>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Zahtjevi profesora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

            .navbar-brand-text:hover {
                color: #a0c8f0;
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .badge-novi {
            background: #e74c3c;
            color: white;
            border-radius: 10px;
            padding: 2px 8px;
            font-size: 0.75rem;
            margin-left: 5px;
        }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

            .content-area h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 5px;
                text-align: center;
            }

        .sekcija {
            background: rgba(255,255,255,0.35);
            border-radius: 12px;
            overflow: hidden;
        }

        .sekcija-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            border-bottom: 1px solid rgba(26,26,110,0.1);
            cursor: pointer;
            user-select: none;
        }

            .sekcija-header h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 0.95rem;
                margin: 0;
            }

        .toggle-icon {
            color: #1a1a6e;
            font-size: 1rem;
            font-weight: 700;
        }

        .sekcija-body {
            padding: 15px 20px;
        }

        .zahtjev-card {
            background: white;
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
            border-left: 4px solid #8e44ad;
        }

            .zahtjev-card.obraden {
                border-left-color: #27ae60;
                opacity: 0.8;
            }

        .zahtjev-info {
            flex: 1;
            color: #1a1a6e;
        }

            .zahtjev-info strong {
                font-size: 0.92rem;
            }

            .zahtjev-info .meta {
                font-size: 0.8rem;
                opacity: 0.6;
                margin-top: 3px;
            }

            .zahtjev-info .poruka-preview {
                font-size: 0.82rem;
                opacity: 0.7;
                margin-top: 4px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 450px;
            }

        .zahtjev-actions {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-shrink: 0;
            margin-left: 15px;
        }

        .btn-obradi {
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 6px 14px;
            font-size: 0.8rem;
            cursor: pointer;
        }

            .btn-obradi:hover {
                background: #1e8449;
            }

        .btn-proslijedi {
            background: #8e44ad;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 6px 14px;
            font-size: 0.8rem;
            cursor: pointer;
        }

            .btn-proslijedi:hover {
                background: #6c3483;
            }

        .badge-status {
            border-radius: 10px;
            padding: 3px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            margin-left: 8px;
        }

        .badge-nov {
            background: #e74c3c;
            color: white;
        }

        .badge-ok {
            background: #27ae60;
            color: white;
        }

        .stat-row {
            display: flex;
            gap: 12px;
            margin-bottom: 5px;
        }

        .stat-box {
            background: white;
            border-radius: 10px;
            padding: 10px 18px;
            text-align: center;
            flex: 1;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        }

            .stat-box .broj {
                font-size: 1.4rem;
                font-weight: 700;
                color: #1a1a6e;
            }

            .stat-box .label {
                font-size: 0.75rem;
                color: #555;
            }

            .stat-box.novi .broj {
                color: #e74c3c;
            }

            .stat-box.obradjeni .broj {
                color: #27ae60;
            }

        .empty-text {
            color: #1a1a6e;
            opacity: 0.6;
            font-size: 0.88rem;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        .filter-row {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
        }

        .filter-btn {
            border: 2px solid #1a1a6e;
            background: transparent;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 4px 14px;
            font-size: 0.82rem;
            cursor: pointer;
            font-weight: 600;
        }

            .filter-btn.active, .filter-btn:hover {
                background: #1a1a6e;
                color: white;
            }
    </style>
</head>
<body>
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Studentska sluzba - @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <h6>Studentska sluzba panel</h6>
            <a asp-controller="StudentskaSluzba" asp-action="Index">Pocetna</a>
            <a asp-controller="StudentskaSluzba" asp-action="SviZahtjevi">Svi zahtjevi</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjeviProfesora" class="active">
                Zahtjevi profesora
                @if (zahtjevi != null && zahtjevi.Any(z => !z.Procitana))
                {
                    <span class="badge-novi">@zahtjevi.Count(z => !z.Procitana)</span>
                }
            </a>
            <a asp-controller="StudentskaSluzba" asp-action="OdaberiZahtjevZaIzvjestaj">Generisanje izvjestaja</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevStatistika">Zahtjev za statistiku</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevPodaci">Zahtjev za upis/izmjenu</a>
            <a asp-controller="StudentskaSluzba" asp-action="Notifikacije">Slanje notifikacija</a>
        </div>

        <div class="content-area">
            <h5>Zahtjevi profesora</h5>

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            @if (zahtjevi != null)
            {
                int ukupno = zahtjevi.Count;
                int novi = zahtjevi.Count(z => !z.Procitana);
                int obradjeni = zahtjevi.Count(z => z.Procitana);

                <div class="stat-row">
                    <div class="stat-box">
                        <div class="broj">@ukupno</div>
                        <div class="label">Ukupno</div>
                    </div>
                    <div class="stat-box novi">
                        <div class="broj">@novi</div>
                        <div class="label">Neobradjeno</div>
                    </div>
                    <div class="stat-box obradjeni">
                        <div class="broj">@obradjeni</div>
                        <div class="label">Obradjeno</div>
                    </div>
                </div>

                <div class="filter-row">
                    <button class="filter-btn active" onclick="filtriraj('svi', this)">Svi</button>
                    <button class="filter-btn" onclick="filtriraj('novi', this)">Neobradjeni</button>
                    <button class="filter-btn" onclick="filtriraj('obradjeni', this)">Obradjeni</button>
                </div>

                var neobradjeniList = zahtjevi.Where(z => !z.Procitana).OrderByDescending(z => z.DatumSlanja).ToList();
                var obradjeniList = zahtjevi.Where(z => z.Procitana).OrderByDescending(z => z.DatumSlanja).ToList();

                @if (!zahtjevi.Any())
                {
                    <p class="empty-text">Nema zahtjeva od profesora.</p>
                }
                else
                {
                    <div id="lista-zahtjeva">
                        @if (neobradjeniList.Any())
                        {
                            <div style="color:#1a1a6e; font-weight:700; font-size:0.82rem; opacity:0.65; margin-bottom:8px; text-transform:uppercase;" data-section="novi">
                                Na cekanju (@neobradjeniList.Count)
                            </div>
                            foreach (var z in neobradjeniList)
                            {
                                <div class="zahtjev-card" data-status="novi">
                                    <div class="zahtjev-info">
                                        <strong>@z.Naslov</strong>
                                        <span class="badge-status badge-nov">Na cekanju</span>
                                        <div class="poruka-preview">@z.Poruka</div>
                                        <div class="meta">@z.DatumSlanja.ToString("dd.MM.yyyy") u @z.DatumSlanja.ToString("HH:mm")</div>
                                    </div>
                                    <div class="zahtjev-actions">
                                        <form method="post" asp-action="ProslijediZahtjevProfesora"
                                              asp-controller="StudentskaSluzba" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="obavijestId" value="@z.Id" />
                                            <button type="submit" class="btn-proslijedi">Proslijedi adminu</button>
                                        </form>
                                        <form method="post" asp-action="OznaciZahtjevProfesora"
                                              asp-controller="StudentskaSluzba" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="obavijestId" value="@z.Id" />
                                            <button type="submit" class="btn-obradi">Oznaci obradjenim</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }

                        @if (obradjeniList.Any())
                        {
                            <div style="color:#1a1a6e; font-weight:700; font-size:0.82rem; opacity:0.65; margin: 15px 0 8px 0; text-transform:uppercase;" data-section="obradjeni">
                                Obradjeno (@obradjeniList.Count)
                            </div>
                            foreach (var z in obradjeniList)
                            {
                                <div class="zahtjev-card obraden" data-status="obradjeni">
                                    <div class="zahtjev-info">
                                        <strong>@z.Naslov</strong>
                                        <span class="badge-status badge-ok">Obradjeno</span>
                                        <div class="poruka-preview">@z.Poruka</div>
                                        <div class="meta">@z.DatumSlanja.ToString("dd.MM.yyyy") u @z.DatumSlanja.ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <p class="empty-text">Nema zahtjeva od profesora.</p>
            }
        </div>
    </div>

    <script>
        function filtriraj(tip, btn) {
            document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            document.querySelectorAll('.zahtjev-card').forEach(function(k) {
                if (tip === 'svi') k.style.display = 'flex';
                else if (tip === 'novi') k.style.display = k.dataset.status === 'novi' ? 'flex' : 'none';
                else k.style.display = k.dataset.status === 'obradjeni' ? 'flex' : 'none';
            });
            document.querySelectorAll('[data-section]').forEach(function(s) {
                if (tip === 'svi') s.style.display = 'block';
                else if (tip === 'novi') s.style.display = s.dataset.section === 'novi' ? 'block' : 'none';
                else s.style.display = s.dataset.section === 'obradjeni' ? 'block' : 'none';
            });
        }
    </script>
</body>
</html>
