@{
    ViewData["Title"] = "Studentska služba";
    Layout = null;
    var zahtjevi = ViewBag.Zahtjevi as List<ZamETF.Models.ZahtjevZaDokument>;
    var obavijesti = ViewBag.Obavijesti as List<ZamETF.Models.Obavijest>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – Studentska služba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
        }

            .content-area h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 20px;
                text-align: center;
            }

        .zahtjev-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(26,26,110,0.1);
            color: #1a1a6e;
            font-size: 0.9rem;
        }

            .zahtjev-item:last-child {
                border-bottom: none;
            }

        .zahtjev-buttons {
            display: flex;
            gap: 8px;
        }

        .btn-proslijedi {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 5px 14px;
            font-size: 0.8rem;
            cursor: pointer;
        }

            .btn-proslijedi:hover {
                background: #0a3f5a;
            }

        .btn-obradi {
            background: #2ecc71;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 5px 14px;
            font-size: 0.8rem;
            cursor: pointer;
        }

            .btn-obradi:hover {
                background: #27ae60;
            }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .badge-novi {
            background: #e74c3c;
            color: white;
            border-radius: 10px;
            padding: 2px 8px;
            font-size: 0.75rem;
            margin-left: 5px;
        }

        .empty-text {
            color: #1a1a6e;
            opacity: 0.6;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="navbar-brand-text">Početna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Studentska služba - @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main-content">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h6>Studentska služba panel</h6>
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="active">Početna</a>
            <a asp-controller="StudentskaSluzba" asp-action="SviZahtjevi">
                Svi zahtjevi
                @if (zahtjevi != null && zahtjevi.Any())
                {
                    <span class="badge-novi">@zahtjevi.Count</span>
                }
            </a>
            <a asp-controller="StudentskaSluzba" asp-action="OdaberiZahtjevZaIzvjestaj">Generisanje izvještaja</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevStatistika">Zahtjev za statistiku</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevPodaci">Zahtjev za upis/izmjenu</a>
            <a asp-controller="StudentskaSluzba" asp-action="Notifikacije">Slanje notifikacija</a>
        </div>

        <!-- CONTENT -->
        <div class="content-area">
            <h5>Zahtjevi</h5>

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            @if (zahtjevi != null && zahtjevi.Any())
            {
                foreach (var z in zahtjevi)
                {
                    <div class="zahtjev-item">
                        <span>
                            Zahtjev: @z.TipDokumenta za studenta @z.Student?.Ime @z.Student?.Prezime
                            <br />
                            <small style="opacity:0.7">@z.Datum.ToString("dd.MM.yyyy HH:mm")</small>
                        </span>
                        <div class="zahtjev-buttons">
                            <form method="post" asp-action="ProslijediAdminu"
                                  asp-controller="StudentskaSluzba" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="zahtjevId" value="@z.Id" />
                                <button type="submit" class="btn-proslijedi">Proslijedi adminu</button>
                            </form>
                            <form method="post" asp-action="ObradiZahtjev"
                                  asp-controller="StudentskaSluzba" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="zahtjevId" value="@z.Id" />
                                <button type="submit" class="btn-obradi">Označi obrađenim</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="empty-text">Nema novih zahtjeva.</p>
            }
        </div>
    </div>
</body>
</html>