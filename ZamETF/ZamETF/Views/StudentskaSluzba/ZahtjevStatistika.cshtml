@{
    ViewData["Title"] = "Zahtjev za statistiku";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Zahtjev za statistiku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 30px;
        }

            .content-area h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 25px;
                text-align: center;
            }

        .form-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            max-width: 600px;
            margin: 0 auto;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .form-label {
            color: #1a1a6e;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 6px;
            display: block;
        }

        .form-control, .form-select {
            border: 1.5px solid #a0c8f0;
            border-radius: 10px;
            padding: 10px 15px;
            font-size: 0.9rem;
            color: #1a1a6e;
            margin-bottom: 15px;
            width: 100%;
        }

            .form-control:focus, .form-select:focus {
                border-color: #1a1a6e;
                box-shadow: none;
                outline: none;
            }

        .btn-posalji {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 12px 35px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            display: block;
            margin: 0 auto;
            transition: background 0.3s;
        }

            .btn-posalji:hover {
                background: #0a3f5a;
            }

        .section-divider {
            border-top: 1px solid rgba(26,26,110,0.1);
            margin: 20px 0;
        }

        .info-box {
            background: #e8f4fd;
            border-left: 4px solid #1a5f7a;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #1a1a6e;
            font-size: 0.88rem;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .row-fields {
            display: flex;
            gap: 15px;
        }

            .row-fields > div {
                flex: 1;
            }
    </style>
</head>
<body>
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Studentska sluzba - @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <h6>Studentska sluzba panel</h6>
            <a asp-controller="StudentskaSluzba" asp-action="Index">Pocetna</a>
            <a asp-controller="StudentskaSluzba" asp-action="SviZahtjevi">Svi zahtjevi</a>
            <a asp-controller="StudentskaSluzba" asp-action="OdaberiZahtjevZaIzvjestaj">Generisanje izvjestaja</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevStatistika" class="active">Zahtjev za statistiku</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevPodaci">Zahtjev za upis/izmjenu</a>
            <a asp-controller="StudentskaSluzba" asp-action="Notifikacije">Slanje notifikacija</a>
        </div>

        <div class="content-area">
            <h5>Zahtjev za statistiku</h5>

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            <div class="form-card">
                <div class="info-box">
                    Ovaj zahtjev ce biti poslan administratoru koji ce pripremiti trazenu statistiku i obavijestiti vas.
                </div>

                <form method="post" asp-action="PosaljiZahtjevStatistike" asp-controller="StudentskaSluzba">
                    @Html.AntiForgeryToken()

                    <label class="form-label">Tip statistike</label>
                    <select name="tipStatistike" class="form-select">
                        <option value="Prolaznost po predmetima">Prolaznost po predmetima</option>
                        <option value="Prosjecne ocjene po godistu">Prosjecne ocjene po godistu</option>
                        <option value="Broj upisanih studenata">Broj upisanih studenata</option>
                        <option value="Statistika po smjerovima">Statistika po smjerovima</option>
                        <option value="Ostalo">Ostalo</option>
                    </select>

                    <div class="row-fields">
                        <div>
                            <label class="form-label">Period - od</label>
                            <input type="date" name="periodOd" class="form-control" />
                        </div>
                        <div>
                            <label class="form-label">Period - do</label>
                            <input type="date" name="periodDo" class="form-control" />
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <label class="form-label">Opis / detalji zahtjeva</label>
                    <textarea name="opisZahtjeva" class="form-control" rows="4"
                              placeholder="Opisite sta tacno trebate..."></textarea>

                    <button type="submit" class="btn-posalji">Posalji zahtjev adminu</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
