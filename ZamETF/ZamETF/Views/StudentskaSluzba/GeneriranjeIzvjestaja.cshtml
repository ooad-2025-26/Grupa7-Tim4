@{
    ViewData["Title"] = "Generisanje izvjestaja";
    Layout = null;
    var zahtjev = ViewBag.Zahtjev as ZamETF.Models.ZahtjevZaDokument;
    var student = zahtjev?.Student;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Generisanje izvjestaja</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 30px;
            display: flex;
            gap: 30px;
        }

        .left-side {
            flex: 1;
        }

        .right-side {
            width: 260px;
            background: white;
            border-radius: 15px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }

        h5 {
            color: #1a1a6e;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .info-card {
            background: white;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        }

            .info-card p {
                color: #1a1a6e;
                font-size: 0.9rem;
                margin: 0;
            }

            .info-card strong {
                font-size: 1rem;
            }

            .info-card small {
                opacity: 0.6;
            }

        .generiraj-label {
            color: #1a1a6e;
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 10px;
            display: block;
        }

        .btn-tip {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 10px 20px;
            font-size: 0.9rem;
            cursor: pointer;
            width: 100%;
            margin-bottom: 8px;
            transition: background 0.3s;
            text-align: left;
        }

            .btn-tip:hover {
                background: #0a3f5a;
            }

            .btn-tip.selected {
                background: #0a3f5a;
                border: 2px solid #0a0a2e;
            }

        .pdf-icon {
            font-size: 3.5rem;
        }

        .pdf-filename {
            color: #1a1a6e;
            font-size: 0.85rem;
            font-weight: 600;
            text-align: center;
            word-break: break-all;
        }

        .pdf-hint {
            color: #aaa;
            font-size: 0.8rem;
            text-align: center;
        }

        .btn-posalji {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 28px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: background 0.3s;
            width: 100%;
            margin-top: 5px;
        }

            .btn-posalji:hover {
                background: #0a3f5a;
            }

        .btn-preuzmi {
            background: #0a0a2e;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 28px;
            font-size: 0.9rem;
            cursor: pointer;
            width: 100%;
        }

            .btn-preuzmi:hover {
                background: #1a1a6e;
            }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .back-link {
            color: #1a1a6e;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 15px;
            font-weight: 600;
        }

            .back-link:hover {
                text-decoration: underline;
                color: #0a0a2e;
            }
    </style>
</head>
<body>

    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Studentska sluzba - @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <h6>Studentska sluzba panel</h6>
            <a asp-controller="StudentskaSluzba" asp-action="Index">Pocetna</a>
            <a asp-controller="StudentskaSluzba" asp-action="SviZahtjevi">Svi zahtjevi</a>
            <a asp-controller="StudentskaSluzba" asp-action="OdaberiZahtjevZaIzvjestaj" class="active">Generisanje izvjestaja</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevStatistika">Zahtjev za statistiku</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevPodaci">Zahtjev za upis/izmjenu</a>
            <a asp-controller="StudentskaSluzba" asp-action="Notifikacije">Slanje notifikacija</a>
        </div>

        <div class="content-area">
            <div class="left-side">
                <a asp-action="OdaberiZahtjevZaIzvjestaj" asp-controller="StudentskaSluzba" class="back-link">
                    &larr; Nazad na listu zahtjeva
                </a>
                <h5>Generisanje izvjestaja</h5>

                @if (TempData["Uspjeh"] != null)
                {
                    <div class="alert alert-success">@TempData["Uspjeh"]</div>
                }
                @if (TempData["Greska"] != null)
                {
                    <div class="alert alert-danger">@TempData["Greska"]</div>
                }

                <div class="info-card">
                    <p>
                        <strong>@student?.Ime @student?.Prezime</strong><br />
                        Indeks: @student?.Indeks &nbsp;|&nbsp; Godina: @student?.GodinaStudija<br />
                        Email: @student?.Email<br />
                        <small>Zahtjev: @zahtjev?.TipDokumenta &nbsp;&middot;&nbsp; @zahtjev?.Datum.ToString("dd.MM.yyyy HH:mm")</small>
                    </p>
                </div>

                <span class="generiraj-label">Odaberi tip dokumenta:</span>

                <form method="post" asp-action="GenerirajPdf" asp-controller="StudentskaSluzba"
                      target="_blank" id="formGeneriraj">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="zahtjevId" value="@zahtjev?.Id" />
                    <input type="hidden" name="tipIzvjestaja" id="tipIzvjestaja" value="PrepisOcjena" />

                    <button type="submit" class="btn-tip selected" id="btn1"
                            onclick="postaviTip('PrepisOcjena', 'btn1')">
                        Prepis ocjena
                    </button>
                    <button type="submit" class="btn-tip" id="btn2"
                            onclick="postaviTip('OcjenePoGodinama', 'btn2')">
                        Prepis ocjena po godinama
                    </button>
                    <button type="submit" class="btn-tip" id="btn3"
                            onclick="postaviTip('StatusnaPotvrda', 'btn3')">
                        Statusna potvrda
                    </button>
                </form>

                <form method="post" asp-action="PosaljiNaMail" asp-controller="StudentskaSluzba"
                      style="margin-top: 20px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="zahtjevId" value="@zahtjev?.Id" />
                    <input type="hidden" name="tipIzvjestaja" id="tipMaila" value="PrepisOcjena" />
                    <button type="submit" class="btn-posalji">
                        Posalji PDF na email studenta
                    </button>
                </form>
            </div>

            <div class="right-side">
                <div class="pdf-icon">&#x1F4C4;</div>
                <p class="pdf-filename" id="pdfNaziv">
                    @(student != null ? student.Ime + student.Prezime + "PrepisOcjena.pdf" : "dokument.pdf")
                </p>
                <p class="pdf-hint">Klikni dugme za preuzimanje ili posalji na email</p>
                <div style="margin-top: 10px; text-align: center; color: #1a1a6e; font-size: 0.85rem;">
                    <strong>Email studenta:</strong><br />
                    @student?.Email
                </div>
            </div>
        </div>
    </div>

    <script>
        var imeStudenta = '@(student?.Ime ?? "")@(student?.Prezime ?? "")';

        var nazivi = {
            'PrepisOcjena': imeStudenta + 'PrepisOcjena.pdf',
            'OcjenePoGodinama': imeStudenta + 'OcjenePoGodinama.pdf',
            'StatusnaPotvrda': imeStudenta + 'StatusnaPotvrda.pdf'
        };

        function postaviTip(tip, btnId) {
            document.getElementById('tipIzvjestaja').value = tip;
            document.getElementById('tipMaila').value = tip;
            document.getElementById('pdfNaziv').textContent = nazivi[tip];

            document.querySelectorAll('.btn-tip').forEach(function(b) {
                b.classList.remove('selected');
            });
            document.getElementById(btnId).classList.add('selected');
        }
    </script>

</body>
</html>
