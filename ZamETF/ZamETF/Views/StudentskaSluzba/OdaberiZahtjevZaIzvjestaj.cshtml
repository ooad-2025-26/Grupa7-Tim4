@model List<ZamETF.Models.ZahtjevZaDokument>
@{
    ViewData["Title"] = "Odaberi zahtjev";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Odabir zahtjeva</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
        }

            .content-area h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 20px;
                text-align: center;
            }

        .zahtjev-card {
            background: white;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .zahtjev-info {
            color: #1a1a6e;
            font-size: 0.9rem;
        }

            .zahtjev-info small {
                opacity: 0.6;
            }

        .badge-status {
            border-radius: 10px;
            padding: 3px 10px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-left: 8px;
        }

        .badge-nov {
            background: #e74c3c;
            color: white;
        }

        .badge-obraden {
            background: #2ecc71;
            color: white;
        }

        .btn-odaberi {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 7px 18px;
            font-size: 0.85rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

            .btn-odaberi:hover {
                background: #0a3f5a;
                color: white;
            }

        .empty-text {
            color: #1a1a6e;
            opacity: 0.6;
            font-size: 0.9rem;
        }

        .info-text {
            color: #1a1a6e;
            font-size: 0.9rem;
            margin-bottom: 15px;
            opacity: 0.8;
        }
    </style>
</head>
<body>
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="StudentskaSluzba" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Studentska sluzba - @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <h6>Studentska sluzba panel</h6>
            <a asp-controller="StudentskaSluzba" asp-action="Index">Pocetna</a>
            <a asp-controller="StudentskaSluzba" asp-action="SviZahtjevi">Svi zahtjevi</a>
            <a asp-controller="StudentskaSluzba" asp-action="OdaberiZahtjevZaIzvjestaj" class="active">Generisanje izvjestaja</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevStatistika">Zahtjev za statistiku</a>
            <a asp-controller="StudentskaSluzba" asp-action="ZahtjevPodaci">Zahtjev za upis/izmjenu</a>
            <a asp-controller="StudentskaSluzba" asp-action="Notifikacije">Slanje notifikacija</a>
        </div>

        <div class="content-area">
            <h5>Odaberi zahtjev za generisanje izvjestaja</h5>
            <p class="info-text">Klikni na zahtjev da generises i posaljes dokument studentu.</p>

            @if (Model != null && Model.Any())
            {
                foreach (var z in Model)
                {
                    <div class="zahtjev-card">
                        <div class="zahtjev-info">
                            <strong>@z.TipDokumenta</strong>
                            @if (z.Status)
                            {
                                <span class="badge-status badge-obraden">Obradjeno</span>
                            }
                            else
                            {
                                <span class="badge-status badge-nov">Novo</span>
                            }
                            <br />
                            Student: @z.Student?.Ime @z.Student?.Prezime
                            (indeks: @z.Student?.Indeks)
                            <br />
                            <small>@z.Datum.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>
                        <a asp-action="GeneriranjeIzvjestaja"
                           asp-controller="StudentskaSluzba"
                           asp-route-zahtjevId="@z.Id"
                           class="btn-odaberi">
                            Generisi &rarr;
                        </a>
                    </div>
                }
            }
            else
            {
                <p class="empty-text">Nema zahtjeva za dokumente.</p>
            }
        </div>
    </div>
</body>
</html>
