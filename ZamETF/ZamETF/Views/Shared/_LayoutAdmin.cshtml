@inject ZamETF.Data.ApplicationDbContext _context
@inject Microsoft.AspNetCore.Identity.UserManager<ZamETF.Models.Korisnik> _userManager
@using Microsoft.EntityFrameworkCore
@{
    var currentKorisnik = await _userManager.GetUserAsync(User);
    var obavijestiCount = currentKorisnik != null 
        ? await _context.Obavijesti.CountAsync(o => o.PrimalacId == currentKorisnik.Id && !o.Procitana) 
        : 0;
    
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { min-height: 100vh; background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%); display: flex; flex-direction: column; }
        .navbar-top { background: linear-gradient(90deg, #1a1a6e, #2d2d9e); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .navbar-left { display: flex; align-items: center; gap: 20px; }
        .navbar-top img { height: 35px; }
        .navbar-brand-text { color: white; font-weight: 600; font-size: 1rem; text-decoration: none; }
        .navbar-brand-text:hover { color: #a0c8f0; }
        .navbar-right { display: flex; align-items: center; gap: 10px; }
        .user-badge { background: white; color: #1a1a6e; border-radius: 20px; padding: 6px 16px; font-weight: 600; font-size: 0.9rem; }
        .btn-odjava { background: transparent; color: white; border: 1px solid white; border-radius: 20px; padding: 6px 16px; font-size: 0.9rem; cursor: pointer; text-decoration: none; }
        .btn-odjava:hover { background: rgba(255,255,255,0.1); color: white; }
        .main-content { flex: 1; display: flex; padding: 20px; gap: 20px; }
        .sidebar { background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%); border-radius: 15px; padding: 20px; width: 220px; min-width: 220px; }
        .sidebar h6 { color: #1a1a6e; font-weight: 700; font-size: 1rem; margin-bottom: 15px; text-align: center; }
        .sidebar a { display: block; color: #1a1a6e; text-decoration: none; padding: 8px 0; font-size: 0.9rem; border-bottom: 1px solid rgba(26,26,110,0.1); font-weight: 600; }
        .sidebar a:hover { color: #0a0a2e; }
        .sidebar a:last-child { border-bottom: none; }
        .sidebar a.active { text-decoration: underline; }
        .badge-novi { background: #e74c3c; color: white; border-radius: 10px; padding: 2px 8px; font-size: 0.75rem; margin-left: 5px; }
        .content-area { flex: 1; display: flex; flex-direction: column; gap: 18px; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
<div class="navbar-top">
    <div class="navbar-left">
        <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
        <a asp-controller="Administrator" asp-action="Index" class="navbar-brand-text">Početna</a>
    </div>
    <div class="navbar-right">
        <span class="user-badge">Admin: @(currentKorisnik != null ? currentKorisnik.UserName : User.Identity.Name)</span>
        <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-odjava">Odjava</button>
        </form>
    </div>
</div>

<div class="main-content">
    <div class="sidebar">
        <h6>Admin panel</h6>
        <a asp-controller="Administrator" asp-action="Index" class="@(currentAction == "Index" ? "active" : "")">
            Početna
            @if (obavijestiCount > 0)
            {
                <span class="badge-novi">@obavijestiCount</span>
            }
        </a>
        <a asp-controller="Administrator" asp-action="SviZahtjevi" class="@(currentAction == "SviZahtjevi" ? "active" : "")">Svi zahtjevi</a>
        <a asp-controller="Administrator" asp-action="Statistika" class="@(currentAction == "Statistika" ? "active" : "")">Generisanje statistike</a>
        <a asp-controller="Administrator" asp-action="UnosIzmjena" class="@(currentAction == "UnosIzmjena" ? "active" : "")">Unos/izmjena podataka</a>
        <a asp-controller="Administrator" asp-action="KreiranjePredmeta" class="@(currentAction == "KreiranjePredmeta" ? "active" : "")">Kreiranje predmeta</a>
        <a asp-controller="Administrator" asp-action="Notifikacije" class="@(currentAction == "Notifikacije" ? "active" : "")">Slanje notifikacija</a>
    </div>

    <div class="content-area">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
