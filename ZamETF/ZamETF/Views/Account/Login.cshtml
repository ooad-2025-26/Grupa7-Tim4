@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – Prijava</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 12px 24px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .navbar-top img {
                height: 40px;
            }

        .main-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        h2 {
            color: white;
            font-weight: 700;
            text-align: center;
            margin-bottom: 30px;
            font-size: 1.8rem;
        }

        .login-card {
            background: linear-gradient(135deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 750px;
            display: flex;
            gap: 40px;
            align-items: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        .login-form-side {
            flex: 1;
        }

        .login-logo-side {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

            .login-logo-side img {
                width: 160px;
            }

        .form-label {
            color: #1a1a4e;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .form-control {
            border-radius: 25px;
            border: none;
            padding: 12px 20px;
            background: white;
            box-shadow: none;
            font-size: 0.95rem;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(26, 26, 110, 0.2);
                border: none;
            }

        .btn-login {
            background: #0a0a2e;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 12px 40px;
            font-weight: 600;
            font-size: 1rem;
            width: 100%;
            margin-top: 10px;
            transition: background 0.3s;
        }

            .btn-login:hover {
                background: #1a1a6e;
                color: white;
            }

        .forgot-password {
            color: #1a1a6e;
            font-size: 0.9rem;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-top: 8px;
        }

            .forgot-password:hover {
                text-decoration: underline;
                color: #0a0a2e;
            }

        .alert-danger {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="navbar-top">
        <img src="~/images/etf-logo.png" alt="ETF Logo" onerror="this.style.display='none'" />
    </div>

    <div class="main-container">
        <div>
            <h2>Dobrodošli na ZamETF</h2>
            <div class="login-card">
                <!-- Lijeva strana – forma -->
                <div class="login-form-side">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <p class="mb-0">@error.ErrorMessage</p>
                            }
                        </div>
                    }

                    <form method="post" asp-action="Login" asp-controller="Account">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Email ili korisničko ime</label>
                            <input type="text" name="email" class="form-control" placeholder="" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="lozinka" class="form-control" placeholder="" required />
                        </div>

                        <button type="submit" class="btn btn-login">Prijava</button>
                        <a href="#" class="forgot-password">Promjena šifre?</a>
                    </form>
                </div>

                <!-- Desna strana – logo -->
                <div class="login-logo-side">
                    <img src="~/images/etf-logo.png" alt="ETF Logo" onerror="this.innerHTML='<div style=font-size:5rem;color:#1a1a6e>ETF</div>'" />
                </div>
            </div>
        </div>
    </div>
</body>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
</html>