@{
    ViewData["Title"] = "Zahtjev za dokument";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – Zahtjev za dokument</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left { display: flex; align-items: center; gap: 20px; }
        .navbar-top img { height: 35px; }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-brand-text:hover { color: #a0c8f0; }
        .navbar-right { display: flex; align-items: center; gap: 10px; }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-odjava:hover { background: rgba(255,255,255,0.1); color: white; }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

        .sidebar h6 {
            color: #1a1a6e;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 5px;
        }

        .sidebar .semestar {
            color: #1a1a6e;
            font-size: 0.8rem;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(26,26,110,0.2);
        }

        .sidebar a {
            display: block;
            color: #1a1a6e;
            text-decoration: none;
            padding: 6px 0;
            font-size: 0.85rem;
        }

        .sidebar a:hover { font-weight: 600; }
        .sidebar .sidebar-divider {
            border-top: 1px solid rgba(26,26,110,0.2);
            margin: 10px 0;
        }

        .sidebar .sidebar-link-small {
            color: #1a1a6e;
            font-size: 0.82rem;
            text-decoration: none;
            display: block;
            padding: 5px 0;
        }

        .sidebar .sidebar-link-small:hover { font-weight: 600; }
        .sidebar .active { font-weight: 700; text-decoration: underline; }

        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 30px;
            max-width: 600px;
        }

        .content-area h5 {
            color: #1a1a6e;
            font-weight: 700;
            margin-bottom: 25px;
            font-size: 1.1rem;
        }

        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            gap: 15px;
        }

        .form-row label {
            color: #1a1a6e;
            font-size: 0.9rem;
            font-weight: 500;
            width: 140px;
            min-width: 140px;
        }

        .form-control-custom {
            flex: 1;
            border: none;
            border-bottom: 1px solid #1a1a6e;
            background: transparent;
            padding: 6px 8px;
            font-size: 0.9rem;
            color: #1a1a6e;
            outline: none;
        }

        .form-control-custom:focus {
            border-bottom: 2px solid #0a0a2e;
        }

        textarea.form-control-custom {
            border: 1px solid #1a1a6e;
            border-radius: 8px;
            resize: vertical;
            min-height: 80px;
        }

        .btn-pošalji {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 35px;
            font-size: 0.95rem;
            cursor: pointer;
            float: right;
            margin-top: 10px;
            transition: background 0.3s;
        }

        .btn-pošalji:hover { background: #0a3f5a; }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="Student" asp-action="Index" class="navbar-brand-text">Početna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Student: @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main-content">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h6>Trenutni semestar</h6>
            <div class="semestar">Predmeti</div>

            <div class="sidebar-divider"></div>

            <a asp-controller="Student" asp-action="PrijavaIspita" class="sidebar-link-small">Prijava ispita</a>
            <a asp-controller="Student" asp-action="SlanjeZadaca" class="sidebar-link-small">Slanje zadaća</a>
            <a asp-controller="Student" asp-action="ZahtjevZaDokument" class="sidebar-link-small active">Zahtjev za dokumente</a>
        </div>

        <!-- CONTENT -->
        <div class="content-area">
            <h5>Zahtjev za dokument</h5>

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            <form method="post" asp-action="PošaljiZahtjev" asp-controller="Student">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <label>Tip dokumenta</label>
                    <select name="tipDokumenta" class="form-control-custom">
                        <option value="Potvrda o studiranju">Potvrda o studiranju</option>
                        <option value="Prepis ocjena">Prepis ocjena</option>
                        <option value="Ocjene po semestrima">Ocjene po semestrima</option>
                    </select>
                </div>

                <div class="form-row">
                    <label>Napomena</label>
                    <textarea name="napomena" class="form-control-custom"
                              placeholder="Unesite dodatne napomene..."></textarea>
                </div>

                <button type="submit" class="btn-pošalji">Pošalji zahtjev</button>
            </form>
        </div>
    </div>
</body>
</html>