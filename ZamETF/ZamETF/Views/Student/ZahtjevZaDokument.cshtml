@{
    ViewData["Title"] = "Zahtjev za dokument";
    Layout = null;
    var zahtjevi = ViewBag.Zahtjevi as List<ZamETF.Models.ZahtjevZaDokument>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Zahtjev za dokument</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

            .navbar-brand-text:hover {
                color: #a0c8f0;
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-section-title {
            color: #1a1a6e;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .sidebar-divider {
            border-top: 1px solid rgba(26,26,110,0.2);
            margin: 12px 0;
        }

        .sidebar-link {
            color: #1a1a6e;
            text-decoration: none;
            font-size: 0.85rem;
            padding: 5px 0;
            display: block;
        }

            .sidebar-link:hover {
                font-weight: 600;
                color: #0a0a2e;
            }

            .sidebar-link.active {
                font-weight: 700;
                text-decoration: underline;
            }

        .content-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        /* SEKCIJA KARTICA */
        .sekcija {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 0;
            overflow: hidden;
        }

        .sekcija-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 24px;
            border-bottom: 1px solid rgba(26,26,110,0.1);
            cursor: pointer;
            user-select: none;
        }

            .sekcija-header h5 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin: 0;
            }

            .sekcija-header .toggle-icon {
                color: #1a1a6e;
                font-size: 1.1rem;
                font-weight: 700;
                transition: transform 0.2s;
            }

        .sekcija-body {
            padding: 24px;
        }

        /* FORMA */
        .forma-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            margin-bottom: 18px;
        }

        .forma-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .forma-group label {
                color: #1a1a6e;
                font-size: 0.82rem;
                font-weight: 600;
            }

                .forma-group label span {
                    color: #e74c3c;
                }

        .form-select-custom, .form-input-custom {
            border: 1.5px solid rgba(26,26,110,0.25);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 0.88rem;
            color: #1a1a6e;
            background: white;
            outline: none;
            width: 100%;
            transition: border-color 0.2s;
        }

            .form-select-custom:focus, .form-input-custom:focus {
                border-color: #1a1a6e;
            }

        .napomena-row {
            margin-bottom: 18px;
        }

            .napomena-row label {
                color: #1a1a6e;
                font-size: 0.82rem;
                font-weight: 600;
                display: block;
                margin-bottom: 5px;
            }

            .napomena-row textarea {
                border: 1.5px solid rgba(26,26,110,0.25);
                border-radius: 8px;
                padding: 10px 12px;
                font-size: 0.88rem;
                color: #1a1a6e;
                background: white;
                width: 100%;
                resize: vertical;
                min-height: 75px;
                outline: none;
            }

                .napomena-row textarea:focus {
                    border-color: #1a1a6e;
                }

        .forma-akcije {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-posalji {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 9px 28px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-posalji:hover {
                background: #0a3f5a;
            }

        .btn-ponisti {
            background: transparent;
            color: #1a1a6e;
            border: 1.5px solid #1a1a6e;
            border-radius: 20px;
            padding: 9px 22px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-ponisti:hover {
                background: rgba(26,26,110,0.08);
            }

        .aktivni-info {
            color: #1a1a6e;
            font-size: 0.88rem;
            opacity: 0.65;
            margin-top: 5px;
        }

        /* TABELA PRETHODNIH */
        .tabela-zahtjeva {
            width: 100%;
            border-collapse: collapse;
        }

            .tabela-zahtjeva th {
                color: #1a1a6e;
                font-size: 0.82rem;
                font-weight: 700;
                padding: 10px 14px;
                border-bottom: 2px solid rgba(26,26,110,0.15);
                text-align: left;
            }

            .tabela-zahtjeva td {
                color: #1a1a6e;
                font-size: 0.85rem;
                padding: 12px 14px;
                border-bottom: 1px solid rgba(26,26,110,0.08);
                vertical-align: middle;
            }

            .tabela-zahtjeva tr:last-child td {
                border-bottom: none;
            }

            .tabela-zahtjeva tr:hover td {
                background: rgba(255,255,255,0.3);
            }

        .status-obraden {
            color: #27ae60;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .status-ceka {
            color: #e67e22;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .status-icon {
            margin-left: 5px;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .breadcrumb-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 5px;
        }

            .breadcrumb-row a {
                color: #1a1a6e;
                font-size: 0.85rem;
                text-decoration: none;
                opacity: 0.7;
            }

                .breadcrumb-row a:hover {
                    opacity: 1;
                }

            .breadcrumb-row span {
                color: #1a1a6e;
                opacity: 0.4;
                font-size: 0.85rem;
            }

            .breadcrumb-row .current {
                color: #1a1a6e;
                font-size: 0.85rem;
                font-weight: 600;
            }

        .aktivni-zahtjev-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.45);
            border-radius: 10px;
            padding: 10px 15px;
            margin-bottom: 8px;
        }

            .aktivni-zahtjev-row span {
                color: #1a1a6e;
                font-size: 0.88rem;
            }

        .badge-ceka {
            background: #fdebd0;
            color: #e67e22;
            border-radius: 8px;
            padding: 3px 10px;
            font-size: 0.75rem;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="Student" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Student: @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <div class="sidebar-section-title">Predmeti</div>
            <div class="sidebar-section-title" style="font-weight:400; margin-bottom:8px;">Trenutni semestar</div>
            <div class="sidebar-divider"></div>
            <a asp-controller="Student" asp-action="Index" class="sidebar-link">Pocetna</a>
            <a asp-controller="Student" asp-action="PrijavaIspita" class="sidebar-link">Prijava ispita</a>
            <a asp-controller="Student" asp-action="SlanjeZadaca" class="sidebar-link">Slanje zadaca</a>
            <a asp-controller="Student" asp-action="ZahtjevZaDokument" class="sidebar-link active">Zahtjev za dokumente</a>
        </div>

        <div class="content-area">

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            <!-- KREIRANJE ZAHTJEVA -->
            <div class="sekcija">
                <div class="sekcija-header" onclick="toggleSekcija('forma', this)">
                    <h5>Kreiranje novog zahtjeva</h5>
                    <span class="toggle-icon" id="ikona-forma">&#8743;</span>
                </div>
                <div class="sekcija-body" id="tijelo-forma">
                    <form method="post" asp-action="PosaljiZahtjev" asp-controller="Student" id="formaZahtjev">
                        @Html.AntiForgeryToken()

                        <div class="forma-grid">
                            <div class="forma-group">
                                <label>Tip potvrde <span>*</span></label>
                                <select name="tipDokumenta" class="form-select-custom" id="tipDokumenta"
                                        onchange="azurirajPrikaz()">
                                    <option value="">-- Odaberi --</option>
                                    <option value="Statusna potvrda">Statusna potvrda</option>
                                    <option value="Prepis ocjena">Prepis ocjena</option>
                                    <option value="Prepis ocjena po godinama">Prepis ocjena po godinama</option>
                                    <option value="Potvrda o studiranju">Potvrda o studiranju</option>
                                </select>
                            </div>
                            <div class="forma-group">
                                <label>Jezik <span>*</span></label>
                                <select name="jezik" class="form-select-custom">
                                    <option value="B/H/S jezik">B/H/S jezik</option>
                                    <option value="Engleski jezik">Engleski jezik</option>
                                </select>
                            </div>
                            <div class="forma-group" id="grupaStatusna">
                                <label>Statusna potvrda</label>
                                <select name="svrha" class="form-select-custom">
                                    <option value="">-- Svrha --</option>
                                    <option value="Regulisanje stipendije">Regulisanje stipendije</option>
                                    <option value="Zdravstveno osiguranje">Zdravstveno osiguranje</option>
                                    <option value="Vojni rok">Vojni rok</option>
                                    <option value="Ostalo">Ostalo</option>
                                </select>
                            </div>
                        </div>

                        <div class="napomena-row">
                            <label>Napišite detalje zahtjeva</label>
                            <textarea name="napomena" placeholder="Napisite detalje zahtjeva"></textarea>
                        </div>

                        <div class="forma-akcije">
                            <button type="button" class="btn-ponisti" onclick="resetujFormu()">Ponisti</button>
                            <button type="submit" class="btn-posalji">Posalji</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- PRETHODNI ZAHTJEVI -->
            <div class="sekcija">
                <div class="sekcija-header" onclick="toggleSekcija('prethodni', this)">
                    <h5>Prethodni zahtjevi</h5>
                    <span class="toggle-icon" id="ikona-prethodni">&#8743;</span>
                </div>
                <div class="sekcija-body" id="tijelo-prethodni">
                    @if (zahtjevi != null && zahtjevi.Any())
                    {
                        <table class="tabela-zahtjeva">
                            <thead>
                                <tr>
                                    <th>Tip dokumenta</th>
                                    <th>Datum</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var z in zahtjevi.OrderByDescending(z2 => z2.Datum))
                                {
                                    <tr>
                                        <td>@z.TipDokumenta</td>
                                        <td>@z.Datum.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (z.Status)
                                            {
                                                <span class="status-obraden">obradjeno &#10003;</span>
                                            }
                                            else
                                            {
                                                <span class="status-ceka">na cekanju</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="aktivni-info">Nema prethodnih zahtjeva.</p>
                    }
                </div>
            </div>

        </div>
    </div>

    <script>
        function toggleSekcija(naziv, header) {
            var tijelo = document.getElementById('tijelo-' + naziv);
            var ikona = document.getElementById('ikona-' + naziv);
            if (tijelo.style.display === 'none') {
                tijelo.style.display = 'block';
                ikona.innerHTML = '&#8743;';
            } else {
                tijelo.style.display = 'none';
                ikona.innerHTML = '&#8744;';
            }
        }

        function resetujFormu() {
            document.getElementById('formaZahtjev').reset();
        }

        function azurirajPrikaz() {
            var tip = document.getElementById('tipDokumenta').value;
            var grupaStatusna = document.getElementById('grupaStatusna');
            grupaStatusna.style.visibility = (tip === 'Statusna potvrda') ? 'visible' : 'hidden';
        }

        // Inicijalno sakrij svrhu ako nije statusna
        azurirajPrikaz();
    </script>
</body>
</html>
