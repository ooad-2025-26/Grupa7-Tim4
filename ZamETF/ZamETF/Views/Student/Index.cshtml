@{
    ViewData["Title"] = "Pocetna";
    Layout = null;
    var obavijesti = ViewBag.Obavijesti as List<ZamETF.Models.Obavijest>;
    var predmeti = ViewBag.Predmeti as List<ZamETF.Models.Predmet>;
    var aktuelno = ViewBag.Aktuelno as List<ZamETF.Models.Obavijest>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

            .navbar-brand-text:hover {
                color: #a0c8f0;
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-section-title {
            color: #1a1a6e;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .sidebar-predmet {
            color: #1a1a6e;
            text-decoration: none;
            font-size: 0.85rem;
            padding: 5px 0;
            display: block;
        }

            .sidebar-predmet:hover {
                font-weight: 600;
                color: #0a0a2e;
            }

        .sidebar-divider {
            border-top: 1px solid rgba(26,26,110,0.2);
            margin: 12px 0;
        }

        .sidebar-link {
            color: #1a1a6e;
            text-decoration: none;
            font-size: 0.85rem;
            padding: 5px 0;
            display: block;
        }

            .sidebar-link:hover {
                font-weight: 600;
                color: #0a0a2e;
            }

            .sidebar-link.active {
                font-weight: 700;
                text-decoration: underline;
            }

        .content-wrapper {
            flex: 1;
            display: flex;
            gap: 20px;
        }

        .card-panel {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

            .card-panel h5 {
                color: #1a1a6e;
                font-weight: 700;
                text-align: center;
                margin-bottom: 15px;
                font-size: 1rem;
            }

        .empty-text {
            color: #1a1a6e;
            opacity: 0.6;
            font-size: 0.85rem;
        }

        /* OBAVIJESTI */
        .obavijest-item {
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            border-left: 4px solid #1a5f7a;
            background: rgba(255,255,255,0.5);
            transition: background 0.2s;
        }

            .obavijest-item:hover {
                background: rgba(255,255,255,0.8);
            }

            .obavijest-item.neprocitana {
                background: rgba(255,255,255,0.75);
                border-left-color: #e74c3c;
            }

            .obavijest-item.procitana {
                background: rgba(255,255,255,0.3);
                border-left-color: #a0c8f0;
                opacity: 0.8;
            }

        .obavijest-naslov {
            color: #1a1a6e;
            font-weight: 700;
            font-size: 0.88rem;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .obavijest-poruka {
            color: #1a1a6e;
            font-size: 0.8rem;
            opacity: 0.75;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        .obavijest-meta {
            color: #1a1a6e;
            font-size: 0.72rem;
            opacity: 0.55;
            margin-top: 3px;
        }

        .badge-tip {
            font-size: 0.68rem;
            font-weight: 700;
            border-radius: 8px;
            padding: 2px 7px;
            flex-shrink: 0;
        }

        .badge-Obavijest {
            background: #d6eaf8;
            color: #1a5f7a;
        }

        .badge-Upozorenje {
            background: #fdebd0;
            color: #e67e22;
        }

        .badge-Podsjetnik {
            background: #f5eef8;
            color: #8e44ad;
        }

        .badge-novo {
            background: #e74c3c;
            color: white;
            font-size: 0.65rem;
            border-radius: 8px;
            padding: 2px 6px;
            font-weight: 700;
        }

        /* AKTUELNO */
        .aktuelno-item {
            display: flex;
            flex-direction: column;
            gap: 3px;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            background: rgba(255,255,255,0.5);
            border-left: 4px solid #1a5f7a;
        }

            .aktuelno-item:last-child {
                border-bottom: none;
            }

        .btn-pogledaj {
            color: #1a1a6e;
            font-weight: 700;
            text-decoration: none;
            font-size: 0.85rem;
            white-space: nowrap;
        }

            .btn-pogledaj:hover {
                text-decoration: underline;
            }

        .notif-count {
            background: #e74c3c;
            color: white;
            border-radius: 10px;
            padding: 1px 7px;
            font-size: 0.72rem;
            font-weight: 700;
            margin-left: 5px;
        }
    </style>
</head>
<body>
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="Student" asp-action="Index" class="navbar-brand-text">Pocetna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">Student: @User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <div class="sidebar-section-title">Predmeti</div>
            <div class="sidebar-section-title" style="font-weight:400; margin-bottom:8px;">Trenutni semestar</div>
            @if (predmeti != null && predmeti.Any())
            {
                <div class="predmet-grid">
                    @foreach (var p in predmeti)
                    {
                        <a asp-controller="Student"
                           asp-action="DetaljiPredmeta"
                           asp-route-id="@p.Id"
                           class="sidebar-predmet">@p.Naziv</a>
                    }
                </div>
            }
            else
            {
                <span class="empty-text">Nema predmeta.</span>
            }
            
            <div class="sidebar-divider"></div>
            <a asp-controller="Student" asp-action="Index" class="sidebar-link active">Prikazi arhivirane predmete</a>
            <a asp-controller="Student" asp-action="SlanjeZadaca" class="sidebar-link">Slanje zadaca</a>
            <a asp-controller="Ispit" asp-action="StudentIspit" class="sidebar-link">Prijava ispita</a>
            <a asp-controller="Student" asp-action="ZahtjevZaDokument" class="sidebar-link">Zahtjev za dokumente</a>
        </div>

        <div class="content-wrapper">
            <!-- OBAVIJESTI -->
            <div class="card-panel">
                <h5>
                    Obavijesti
                    @if (obavijesti != null && obavijesti.Any(o => !o.Procitana))
                    {
                        <span class="notif-count">@obavijesti.Count(o => !o.Procitana)</span>
                    }
                </h5>

                @if (obavijesti != null && obavijesti.Any())
                {
                    foreach (var o in obavijesti)
                    {
                        var tipKlasa = "";
                        var tipLabel = "";
                        if (o.Naslov != null && o.Naslov.StartsWith("[Upozorenje]"))
                        {
                            tipKlasa = "badge-Upozorenje";
                            tipLabel = "Upozorenje";
                        }
                        else if (o.Naslov != null && o.Naslov.StartsWith("[Podsjetnik]"))
                        {
                            tipKlasa = "badge-Podsjetnik";
                            tipLabel = "Podsjetnik";
                        }
                        else if (o.Naslov != null && o.Naslov.StartsWith("[Obavijest]"))
                        {
                            tipKlasa = "badge-Obavijest";
                            tipLabel = "Obavijest";
                        }

                        <a asp-controller="Student"
                           asp-action="DetaljiObavijesti"
                           asp-route-id="@o.Id"
                           class="obavijest-item @(o.Procitana ? "procitana" : "neprocitana")">
                            <div class="obavijest-naslov">
                                @if (!string.IsNullOrEmpty(tipLabel))
                                {
                                    <span class="badge-tip @tipKlasa">@tipLabel</span>
                                }
                                @(o.Naslov?.Replace("[Obavijest] ", "").Replace("[Upozorenje] ", "").Replace("[Podsjetnik] ", "") ?? "")
                                @if (!o.Procitana)
                                {
                                    <span class="badge-novo">NOVO</span>
                                }
                            </div>
                            <div class="obavijest-poruka">@o.Poruka</div>
                            <div class="obavijest-meta">@o.DatumSlanja.ToString("dd.MM.yyyy") u @o.DatumSlanja.ToString("HH:mm")</div>
                        </a>
                    }
                }
                else
                {
                    <span class="empty-text">Nema novih obavijesti.</span>
                }
            </div>

            <!-- AKTUELNO -->
            <div class="card-panel">
                <h5>Aktuelno!</h5>
                @if (aktuelno != null && aktuelno.Any())
                {
                    foreach (var a in aktuelno)
                    {
                      <div class="aktuelno-item">
                          <span style="font-size:0.85rem; color:#1a1a6e;">@a.Naslov</span>
                          <span style="font-size:0.75rem; color:#1a1a6e; opacity:0.65;">@a.Poruka</span>
                      </div>
                    }
                }
                else
                {
                    <span class="empty-text">Nema aktuelnih obavijesti.</span>
                }
            </div>
        </div>
    </div>
</body>
</html>
