@model ZamETF.ViewModels.IspitCreateVM
@{
    ViewData["Title"] = "Postavi ispit";
}

<div class="zametf-page">
    <div class="zametf-wrap">
    <div class="zametf-card" style="max-width:560px; margin:0 auto;">
        <h2 class="zametf-naslov">Postavi novi ispit</h2>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="zametf-greska"></div>

            <div class="zametf-polje">
                <label asp-for="PredmetId"></label>
                <select asp-for="PredmetId" asp-items="@(ViewBag.Predmeti as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="zametf-input">
                    <option value="">-- odaberi predmet --</option>
                </select>
                <span asp-validation-for="PredmetId" class="zametf-greska"></span>
            </div>

            <div class="zametf-polje">
                <label asp-for="Datum"></label>
                <input asp-for="Datum" type="datetime-local" class="zametf-input" />
                <span asp-validation-for="Datum" class="zametf-greska"></span>
            </div>

            <div class="zametf-polje">
                <label asp-for="RokZaPrijavu"></label>
                <input asp-for="RokZaPrijavu" type="datetime-local" class="zametf-input" />
                <span asp-validation-for="RokZaPrijavu" class="zametf-greska"></span>
            </div>

            <div style="text-align:center; margin-top:24px;">
                <button type="submit" class="btn-zametf">Postavi ispit</button>
                <a asp-action="Index" class="btn-zametf-sekundarni">Odustani</a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
