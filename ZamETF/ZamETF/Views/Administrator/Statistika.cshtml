@{
    ViewData["Title"] = "Generisanje statistike";
    Layout = null;
    var zahtjevi = ViewBag.Zahtjevi as List<ZamETF.Models.Obavijest>;
    var studenti = ViewBag.Studenti as List<ZamETF.Models.Student>;
    var profesori = ViewBag.Profesori as List<ZamETF.Models.Profesor>;
    var predmeti = ViewBag.Predmeti as List<ZamETF.Models.Predmet>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – Statistika</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
                font-weight: 600;
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

                .sidebar a.active {
                    text-decoration: underline;
                }

        .content-area {
            flex: 1;
            display: flex;
            gap: 20px;
            flex-direction: column;
        }

        /* Zahtjevi panel */
        .zahtjevi-panel {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
        }

            .zahtjevi-panel h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 15px;
            }

        .zahtjev-card {
            background: rgba(255,255,255,0.5);
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .zahtjev-info {
            flex: 1;
        }

            .zahtjev-info .naslov {
                color: #1a1a6e;
                font-weight: 600;
                font-size: 0.9rem;
            }

            .zahtjev-info .detalji {
                color: #1a1a6e;
                font-size: 0.8rem;
                opacity: 0.8;
                margin-top: 3px;
            }

        .zahtjev-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-generiraj {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 6px 16px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: background 0.3s;
        }

            .btn-generiraj:hover {
                background: #0a3f5a;
            }

        .btn-download {
            background: #2ecc71;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 6px 16px;
            font-size: 0.8rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

            .btn-download:hover {
                background: #27ae60;
                color: white;
            }

        .btn-posalji {
            background: #0a0a2e;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 6px 16px;
            font-size: 0.8rem;
            cursor: pointer;
        }

            .btn-posalji:hover {
                background: #1a1a6e;
            }

        /* Manualno panel */
        .manualno-panel {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
        }

            .manualno-panel h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 15px;
            }

        .manualno-grid {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .manualno-card {
            flex: 1;
            min-width: 200px;
            background: rgba(255,255,255,0.5);
            border-radius: 12px;
            padding: 15px;
        }

            .manualno-card h6 {
                color: #1a1a6e;
                font-weight: 600;
                margin-bottom: 10px;
                font-size: 0.9rem;
            }

        .select-korisnik {
            width: 100%;
            border: none;
            border-bottom: 1px solid #1a1a6e;
            background: transparent;
            padding: 6px 4px;
            color: #1a1a6e;
            font-size: 0.85rem;
            margin-bottom: 10px;
            outline: none;
        }

        .btn-manualno {
            background: #1a5f7a;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 7px 18px;
            font-size: 0.85rem;
            cursor: pointer;
            width: 100%;
        }

            .btn-manualno:hover {
                background: #0a3f5a;
            }

        .alert {
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .empty-text {
            color: #1a1a6e;
            opacity: 0.6;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="Administrator" asp-action="Index" class="navbar-brand-text">Početna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">@User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main-content">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h6>Admin panel</h6>
            <a asp-controller="Administrator" asp-action="Index">Početna</a>
            <a asp-controller="Administrator" asp-action="UnosIzmjena">Unos/izmjena podataka</a>
            <a asp-controller="Administrator" asp-action="Statistika" class="active">Generisanje statistike</a>
            <a asp-controller="Administrator" asp-action="Notifikacije">Slanje notifikacija</a>
            <a asp-controller="Administrator" asp-action="Zahtjevi">Svi zahtjevi</a>
            <a asp-controller="Administrator" asp-action="ObradeniZahtjevi">Obrađeni zahtjevi</a>
        </div>

        <!-- CONTENT -->
        <div class="content-area">

            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success">@TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger">@TempData["Greska"]</div>
            }

            <!-- ZAHTJEVI OD STUDENTSKE SLUZBE -->
            <div class="zahtjevi-panel">
                <h5>Zahtjevi od studentske službe</h5>

                @if (zahtjevi != null && zahtjevi.Any())
                {
                    foreach (var z in zahtjevi)
                    {
                        var student = z.Zahtjev?.Student;
                        <div class="zahtjev-card">
                            <div class="zahtjev-info">
                                <div class="naslov">@z.Naslov</div>
                                @if (student != null)
                                {
                                    <div class="detalji">
                                        Student: @student.Ime @student.Prezime
                                        | Indeks: @student.Indeks
                                        | Datum: @z.DatumSlanja.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                }
                            </div>
                            <div class="zahtjev-buttons">
                                <!-- Generiši i download -->
                                <form method="post"
                                      asp-action="GenerirajIzZahtjeva"
                                      asp-controller="Administrator"
                                      target="_blank"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="obavijestId" value="@z.Id" />
                                    <button type="submit" class="btn-download">
                                        ⬇ Generiši i preuzmi
                                    </button>
                                </form>

                                <!-- Pošalji studentskoj -->
                                <form method="post"
                                      asp-action="PošaljiPdfStudentskaSluzba"
                                      asp-controller="Administrator"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="obavijestId" value="@z.Id" />
                                    <button type="submit" class="btn-posalji">
                                        ✉ Pošalji studentskoj
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-text">Nema novih zahtjeva od studentske službe.</p>
                }
            </div>

            <!-- MANUALNO GENERISANJE -->
            <div class="manualno-panel">
                <h5>Manualno generisanje statistike</h5>
                <div class="manualno-grid">

                    <!-- Student -->
                    <div class="manualno-card">
                        <h6>Statistika za studenta</h6>
                        <form method="post"
                              asp-action="GenerirajStatistikuStudenta"
                              asp-controller="Administrator"
                              target="_blank">
                            @Html.AntiForgeryToken()
                            <select name="studentId" class="select-korisnik">
                                <option value="">-- Odaberi studenta --</option>
                                @if (studenti != null)
                                {
                                    foreach (var s in studenti)
                                    {
                                        <option value="@s.Id">@s.Ime @s.Prezime (@s.Indeks)</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn-manualno">Generiši PDF</button>
                        </form>
                    </div>

                    <!-- Profesor -->
                    <div class="manualno-card">
                        <h6>Statistika za profesora</h6>
                        <form method="post"
                              asp-action="GenerirajStatistikuProfesora"
                              asp-controller="Administrator"
                              target="_blank">
                            @Html.AntiForgeryToken()
                            <select name="profesorId" class="select-korisnik">
                                <option value="">-- Odaberi profesora --</option>
                                @if (profesori != null)
                                {
                                    foreach (var p in profesori)
                                    {
                                        <option value="@p.Id">@p.Ime @p.Prezime</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn-manualno">Generiši PDF</button>
                        </form>
                    </div>

                    <!-- Studentska sluzba -->
                    <div class="manualno-card">
                        <h6>Statistika studentske službe</h6>
                        <form method="post"
                              asp-action="GenerirajStatistikuStudentskeSluzbe"
                              asp-controller="Administrator"
                              target="_blank">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-manualno">Generiši PDF</button>
                        </form>
                    </div>

                    <!-- Predmet -->
                    <div class="manualno-card">
                        <h6>Statistika za predmet</h6>
                        <form method="post"
                              asp-action="GenerirajStatistikuPredmeta"
                              asp-controller="Administrator"
                              target="_blank">
                            @Html.AntiForgeryToken()
                            <select name="predmetId" class="select-korisnik">
                                <option value="">-- Odaberi predmet --</option>
                                @if (predmeti != null)
                                {
                                    foreach (var p in predmeti)
                                    {
                                        <option value="@p.Id">@p.Naziv</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn-manualno">Generiši PDF</button>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</body>
</html>