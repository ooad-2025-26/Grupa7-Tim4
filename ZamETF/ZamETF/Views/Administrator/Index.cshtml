@{
    ViewData["Title"] = "Admin Panel";
    Layout = null;
    var obavijesti = ViewBag.Obavijesti as List<ZamETF.Models.Obavijest>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { min-height: 100vh; background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%); display: flex; flex-direction: column; }
        .navbar-top { background: linear-gradient(90deg, #1a1a6e, #2d2d9e); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .navbar-left { display: flex; align-items: center; gap: 20px; }
        .navbar-top img { height: 35px; }
        .navbar-brand-text { color: white; font-weight: 600; font-size: 1rem; text-decoration: none; }
        .navbar-brand-text:hover { color: #a0c8f0; }
        .navbar-right { display: flex; align-items: center; gap: 10px; }
        .user-badge { background: white; color: #1a1a6e; border-radius: 20px; padding: 6px 16px; font-weight: 600; font-size: 0.9rem; }
        .btn-odjava { background: transparent; color: white; border: 1px solid white; border-radius: 20px; padding: 6px 16px; font-size: 0.9rem; cursor: pointer; text-decoration: none; }
        .btn-odjava:hover { background: rgba(255,255,255,0.1); color: white; }
        .main-content { flex: 1; display: flex; padding: 20px; gap: 20px; }
        .sidebar { background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%); border-radius: 15px; padding: 20px; width: 220px; min-width: 220px; }
        .sidebar h6 { color: #1a1a6e; font-weight: 700; font-size: 1rem; margin-bottom: 15px; text-align: center; }
        .sidebar a { display: block; color: #1a1a6e; text-decoration: none; padding: 8px 0; font-size: 0.9rem; border-bottom: 1px solid rgba(26,26,110,0.1); font-weight: 600; }
        .sidebar a:hover { color: #0a0a2e; }
        .sidebar a:last-child { border-bottom: none; }
        .sidebar a.active { text-decoration: underline; }
        .badge-novi { background: #e74c3c; color: white; border-radius: 10px; padding: 2px 8px; font-size: 0.75rem; margin-left: 5px; }
        .content-area { flex: 1; background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%); border-radius: 15px; padding: 25px; }
        .content-area h5 { color: #1a1a6e; font-weight: 700; margin-bottom: 20px; text-align: center; }
        .zahtjev-card { background: white; border-radius: 12px; padding: 14px 20px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.07); border-left: 4px solid #e74c3c; }
        .zahtjev-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.13); }
        .zahtjev-info { flex: 1; color: #1a1a6e; font-size: 0.9rem; }
        .zahtjev-info .naslov { font-weight: 700; font-size: 0.92rem; }
        .zahtjev-info .detalji { font-size: 0.8rem; opacity: 0.65; margin-top: 3px; }
        .zahtjev-actions { display: flex; gap: 8px; flex-shrink: 0; }
        .btn-statistika { background: #1a5f7a; color: white; border: none; border-radius: 15px; padding: 6px 14px; font-size: 0.8rem; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-statistika:hover { background: #0a3f5a; color: white; }
        .btn-obradi { background: #27ae60; color: white; border: none; border-radius: 15px; padding: 6px 14px; font-size: 0.8rem; cursor: pointer; }
        .btn-obradi:hover { background: #1e8449; }
        .alert { border-radius: 10px; margin-bottom: 15px; font-size: 0.9rem; }
        .empty-text { color: #1a1a6e; opacity: 0.6; font-size: 0.9rem; text-align: center; margin-top: 20px; }
        .stats-row { display: flex; gap: 12px; margin-bottom: 20px; justify-content: center; }
        .stat-box { background: white; border-radius: 12px; padding: 12px 20px; text-align: center; min-width: 110px; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
        .stat-box .broj { font-size: 1.6rem; font-weight: 700; color: #1a1a6e; }
        .stat-box .label { font-size: 0.78rem; color: #555; }
    </style>
</head>
<body>
<div class="navbar-top">
    <div class="navbar-left">
        <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
        <a asp-controller="Administrator" asp-action="Index" class="navbar-brand-text">Pocetna</a>
    </div>
    <div class="navbar-right">
        <span class="user-badge">Admin: @User.Identity.Name</span>
        <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-odjava">Odjava</button>
        </form>
    </div>
</div>

<div class="main-content">
    <div class="sidebar">
        <h6>Admin panel</h6>
        <a asp-controller="Administrator" asp-action="Index" class="active">
            Pocetna
            @if (obavijesti != null && obavijesti.Any())
            {
                <span class="badge-novi">@obavijesti.Count</span>
            }
        </a>
        <a asp-controller="Administrator" asp-action="SviZahtjevi">Svi zahtjevi</a>
        <a asp-controller="Administrator" asp-action="Statistika">Generisanje statistike</a>
        <a asp-controller="Administrator" asp-action="UnosIzmjena">Unos/izmjena podataka</a>
        <a asp-controller="Administrator" asp-action="KreiranjePredmeta">Kreiranje predmeta</a>
        <a asp-controller="Administrator" asp-action="Notifikacije">Slanje notifikacija</a>
    </div>

    <div class="content-area">
        <h5>Novi zahtjevi</h5>

        @if (TempData["Uspjeh"] != null)
        {
            <div class="alert alert-success">@TempData["Uspjeh"]</div>
        }
        @if (TempData["Greska"] != null)
        {
            <div class="alert alert-danger">@TempData["Greska"]</div>
        }

        @if (obavijesti != null && obavijesti.Any())
        {
            <div class="stats-row">
                <div class="stat-box">
                    <div class="broj">@obavijesti.Count</div>
                    <div class="label">Novih zahtjeva</div>
                </div>
            </div>

            foreach (var o in obavijesti)
            {
                <div class="zahtjev-card">
                    <div class="zahtjev-info">
                        <div class="naslov">@o.Naslov</div>
                        <div class="detalji">
                            Od: @(o.Posiljалac != null ? o.Posiljалac.Ime + " " + o.Posiljалac.Prezime : "N/A")
                            &nbsp;&middot;&nbsp; @o.DatumSlanja.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>
                    <div class="zahtjev-actions">
                        <a asp-controller="Administrator" asp-action="Statistika" class="btn-statistika">
                            Generisi statistiku
                        </a>
                        <form method="post" asp-action="OznaciObradenim" asp-controller="Administrator" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="obavijestId" value="@o.Id" />
                            <button type="submit" class="btn-obradi">Oznaci obradjenim</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="empty-text">Nema novih zahtjeva.</p>
        }
    </div>
</div>
</body>
</html>
