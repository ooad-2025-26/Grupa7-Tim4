@{
    ViewData["Title"] = "Admin Panel";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
        }

        /* NAVBAR */
        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .navbar-top img {
                height: 35px;
            }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

            .navbar-brand-text:hover {
                color: #a0c8f0;
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        /* MAIN */
        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        /* SIDEBAR */
        .sidebar {
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 15px;
                text-align: center;
            }

            .sidebar a {
                display: block;
                color: #1a1a6e;
                text-decoration: none;
                padding: 8px 0;
                font-size: 0.9rem;
                border-bottom: 1px solid rgba(26,26,110,0.1);
            }

                .sidebar a:hover {
                    color: #0a0a2e;
                    font-weight: 600;
                }

                .sidebar a:last-child {
                    border-bottom: none;
                }

        /* CONTENT */
        .content-area {
            flex: 1;
            background: linear-gradient(180deg, #b8f0e0 0%, #a0c8f0 100%);
            border-radius: 15px;
            padding: 25px;
        }

            .content-area h5 {
                color: #1a1a6e;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .zahtjev-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(26,26,110,0.1);
            color: #1a1a6e;
            font-size: 0.95rem;
        }

            .zahtjev-item:last-child {
                border-bottom: none;
            }

        .btn-pogledaj {
            color: #1a1a6e;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .btn-pogledaj:hover {
                text-decoration: underline;
                color: #0a0a2e;
            }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a href="/Administrator" class="navbar-brand-text">Početna</a>
        </div>
        <div class="navbar-right">
            <span class="user-badge">@User.Identity.Name</span>
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main-content">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h6>Admin panel</h6>
            <a href="/Administrator/UnosIzmjena">Unos/izmjena podataka</a>
            <a href="/Administrator/Statistika">Generisanje statistike</a>
            <a href="/Administrator/Notifikacije">Slanje notifikacija</a>
            <a href="/Administrator/Zahtjevi">Svi zahtjevi</a>
            <a href="/Administrator/ObradeniZahtjevi">Obrađeni zahtjevi</a>
        </div>

        <!-- CONTENT – Zahtjevi -->
        <div class="content-area">
            <h5>Zahtjevi</h5>

            @if (ViewBag.Zahtjevi != null && ((List<ZamETF.Models.AdminZahtjev>)ViewBag.Zahtjevi).Count > 0)
            {
                foreach (var zahtjev in (List<ZamETF.Models.AdminZahtjev>)ViewBag.Zahtjevi)
                {
                    <div class="zahtjev-item">
                        <span>Zahtjev: @zahtjev.Komentar</span>
                        <a href="/Administrator/ObradiZahtjev/@zahtjev.Id" class="btn-pogledaj">Pogledaj</a>
                    </div>
                }
            }
            else
            {
                <p style="color: #1a1a6e; opacity: 0.6;">Nema novih zahtjeva.</p>
            }
        </div>
    </div>
</body>
</html>