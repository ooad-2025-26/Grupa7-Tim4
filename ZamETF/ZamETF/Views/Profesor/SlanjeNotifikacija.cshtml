@{
    ViewData["Title"] = "Slanje notifikacija";
    Layout = "~/Views/Profesor/_LayoutProfesor.cshtml";
    var predmeti = ViewBag.Predmeti as List<ZamETF.Models.Predmet>;
}

<style>
    .form-panel {
        max-width: 620px;
        margin: 0 auto;
        background: linear-gradient(145deg, #b8c8f8 0%, #c8e8c8 100%);
        border-radius: 15px;
        padding: 30px 36px;
        color: #0f1535;
    }

        .form-panel h5 {
            font-size: 1rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 22px;
        }

    .form-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: #1e3a8a;
        margin-bottom: 5px;
    }

    .form-control, .form-select {
        background: rgba(255,255,255,0.6);
        border: 1.5px solid rgba(30,58,138,0.25);
        border-radius: 9px;
        font-size: 0.9rem;
        color: #0f1535;
        padding: 9px 13px;
    }

        .form-control:focus, .form-select:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.8);
            box-shadow: none;
        }

    .hint-text {
        font-size: 0.78rem;
        color: rgba(15,21,53,0.5);
        margin-top: 4px;
    }

    .btn-posalji {
        width: 100%;
        padding: 11px;
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        border: none;
        border-radius: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 6px;
    }

        .btn-posalji:hover {
            opacity: 0.88;
        }
</style>

<div class="form-panel">
    <h5>🔔 Slanje notifikacija studentima</h5>

    <form method="post" asp-controller="Profesor" asp-action="PosaljiNotifikaciju">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Primatelji</label>
            <select name="predmetId" class="form-select">
                <option value="">-- Svi studenti (svi predmeti) --</option>
                @if (predmeti != null)
                {
                    foreach (var p in predmeti)
                    {
                        <option value="@p.Id">Studenti predmeta: @p.Naziv</option>
                    }
                }
            </select>
            <div class="hint-text">Ostavite prazno da pošaljete svim vašim studentima.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Naslov notifikacije</label>
            <input type="text" name="naslov" class="form-control"
                   placeholder="npr. Pomak termina konsultacija" required maxlength="200" />
        </div>

        <div class="mb-3">
            <label class="form-label">Poruka</label>
            <textarea name="poruka" class="form-control" rows="4"
                      placeholder="Unesite tekst obavijesti..." required maxlength="1000"></textarea>
        </div>

        <button type="submit" class="btn-posalji">Pošalji notifikaciju →</button>
    </form>
</div>
