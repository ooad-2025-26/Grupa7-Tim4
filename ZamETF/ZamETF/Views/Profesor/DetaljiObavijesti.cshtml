@{
    ViewData["Title"] = "Detalji obavijesti";
    Layout = "~/Views/Profesor/_LayoutProfesor.cshtml";
    var obavijest = ViewBag.Obavijest as ZamETF.Models.Obavijest;
    var posiljалac = ViewBag.Posiljалac as string;
    var masovnoPoslano = (bool)(ViewBag.MasovnoPoslano ?? false);
}

<style>
    .obavijest-card {
        background: linear-gradient(145deg, #b8c8f8 0%, #c8e8c8 100%);
        border-radius: 18px;
        padding: 35px 40px;
        max-width: 680px;
        margin: 0 auto;
    }

    .back-link {
        color: #1e3a8a;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 20px;
        opacity: 0.75;
    }

        .back-link:hover {
            opacity: 1;
            color: #0f1535;
        }

    .tip-badge {
        font-size: 0.8rem;
        font-weight: 700;
        border-radius: 10px;
        padding: 4px 12px;
        display: inline-block;
        margin-bottom: 12px;
    }

    .tip-Obavijest {
        background: #d6eaf8;
        color: #1a5f7a;
    }

    .tip-Upozorenje {
        background: #fdebd0;
        color: #e67e22;
    }

    .tip-Podsjetnik {
        background: #f5eef8;
        color: #8e44ad;
    }

    .tip-default {
        background: #eaf0fb;
        color: #1e3a8a;
    }

    .obavijest-naslov {
        color: #0f1535;
        font-size: 1.4rem;
        font-weight: 800;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .meta-item {
        color: #0f1535;
        font-size: 0.82rem;
        opacity: 0.6;
    }

        .meta-item strong {
            opacity: 1;
        }

    .divider {
        border-top: 2px solid rgba(30,58,138,0.1);
        margin: 18px 0;
    }

    .poruka-tekst {
        color: #0f1535;
        font-size: 0.97rem;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .masovno-badge {
        background: #1e3a8a;
        color: white;
        border-radius: 10px;
        padding: 3px 12px;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .btn-nazad {
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        color: white;
        border: none;
        border-radius: 20px;
        padding: 10px 28px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-top: 25px;
    }

        .btn-nazad:hover {
            opacity: 0.88;
            color: white;
        }
</style>

<a asp-controller="Profesor" asp-action="Index" class="back-link">&larr; Nazad na pocetnu</a>

<div class="obavijest-card">
    @if (obavijest != null)
    {
        var naslov = obavijest.Naslov ?? "";
        var tipLabel = "";
        var tipKlasa = "tip-default";

        if (naslov.StartsWith("[Upozorenje]")) { tipLabel = "Upozorenje"; tipKlasa = "tip-Upozorenje"; naslov = naslov.Replace("[Upozorenje] ", "").Replace("[Upozorenje]", ""); }
        else if (naslov.StartsWith("[Podsjetnik]")) { tipLabel = "Podsjetnik"; tipKlasa = "tip-Podsjetnik"; naslov = naslov.Replace("[Podsjetnik] ", "").Replace("[Podsjetnik]", ""); }
        else if (naslov.StartsWith("[Obavijest]")) { tipLabel = "Obavijest"; tipKlasa = "tip-Obavijest"; naslov = naslov.Replace("[Obavijest] ", "").Replace("[Obavijest]", ""); }

        if (!string.IsNullOrEmpty(tipLabel))
        {
            <span class="tip-badge @tipKlasa">@tipLabel</span>
        }

        <div class="obavijest-naslov">@naslov</div>

        <div class="meta-row">
            <span class="meta-item">Od: <strong>@(posiljалac ?? "Sistem")</strong></span>
            <span class="meta-item">@obavijest.DatumSlanja.ToString("dd.MM.yyyy") u @obavijest.DatumSlanja.ToString("HH:mm")</span>
            @if (masovnoPoslano)
            {
                <span class="masovno-badge">Poslano svim profesorima</span>
            }
        </div>

        <div class="divider"></div>
        <div class="poruka-tekst">@obavijest.Poruka</div>
        <a asp-controller="Profesor" asp-action="Index" class="btn-nazad">Nazad</a>
    }
    else
    {
        <p style="color:#0f1535;">Obavijest nije pronadjena.</p>
        <a asp-controller="Profesor" asp-action="Index" class="btn-nazad">Nazad</a>
    }
</div>
