@{
    var profesor = ViewBag.Profesor as ZamETF.Models.Profesor;
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZamETF – @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2e 0%, #1a1a6e 50%, #2d2d9e 100%);
            display: flex;
            flex-direction: column;
            font-family: sans-serif;
        }

        .navbar-top {
            background: linear-gradient(90deg, #1a1a6e, #2d2d9e);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-top img {
            height: 35px;
        }

        .navbar-brand-text {
            color: white;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-badge {
            background: white;
            color: #1a1a6e;
            border-radius: 20px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-odjava {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-odjava:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .main-content {
            flex: 1;
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .sidebar {
            background: linear-gradient(180deg, #b8d8f0 0%, #c8e8c8 100%);
            border-radius: 15px;
            padding: 20px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar h6 {
                color: #1a1a6e;
                font-weight: 700;
                font-size: 1rem;
                margin-bottom: 6px;
                text-align: center;
            }

        .sidebar-section {
            font-size: 0.7rem;
            font-weight: 700;
            color: rgba(26,26,110,0.45);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin: 12px 0 4px;
        }

        .sidebar a {
            display: block;
            color: #1a1a6e;
            text-decoration: none;
            padding: 7px 0;
            font-size: 0.88rem;
            border-bottom: 1px solid rgba(26,26,110,0.1);
            font-weight: 500;
        }

            .sidebar a:hover {
                color: #0a0a2e;
                text-decoration: underline;
            }

            .sidebar a:last-child {
                border-bottom: none;
            }

            .sidebar a.active {
                font-weight: 700;
                text-decoration: underline;
            }

        .content-area {
            flex: 1;
        }

        .alert {
            border-radius: 10px;
            font-size: 0.9rem;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="navbar-top">
        <div class="navbar-left">
            <img src="~/images/etf-logo.png" alt="ETF" onerror="this.style.display='none'" />
            <a asp-controller="Profesor" asp-action="Index" class="navbar-brand-text">Početna</a>
        </div>
        <div class="navbar-right">
            @if (profesor != null)
            {
                <span class="user-badge">Profesor: @profesor.Titula @profesor.Ime @profesor.Prezime</span>
            }
            else
            {
                <span class="user-badge">Profesor: @User.Identity.Name</span>
            }
            <form method="post" asp-action="Logout" asp-controller="Account" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-odjava">Odjava</button>
            </form>
        </div>
    </div>

    <div class="main-content">

        <div class="sidebar">
            <h6>Profesor panel</h6>

            <div class="sidebar-section">Predmeti</div>
            <a asp-controller="Profesor" asp-action="Index"
               class="@(ViewData["Title"]?.ToString() == "Početna" ? "active" : "")">
                Pregled predmeta
            </a>

            @if (ViewBag.Predmeti is List<ZamETF.Models.Predmet> predmeti && predmeti.Any())
            {
                foreach (var p in predmeti)
                {
                    <a asp-controller="Profesor" asp-action="DetaljiPredmeta" asp-route-id="@p.Id"
                       class="@(ViewBag.AktivniPredmetId?.ToString() == p.Id.ToString() ? "active" : "")"
                       style="padding-left:10px; font-size:0.82rem;">
                        @p.Naziv
                    </a>
                }
            }

            <div class="sidebar-section">Zadaće</div>
            <a asp-controller="Profesor" asp-action="KreiranjeZadace"
               class="@(ViewData["Title"]?.ToString() == "Kreiranje zadaće" ? "active" : "")">
                Kreiranje zadaće
            </a>

            <div class="sidebar-section">Evidencija</div>
            @{
                var prvPredmetId = (ViewBag.Predmeti is List<ZamETF.Models.Predmet> pl && pl.Any()) ? pl.First().Id : 0;
            }
            <a asp-controller="Profesor" asp-action="EvidencijaPrisustva" asp-route-predmetId="@prvPredmetId"
               class="@(ViewData["Title"]?.ToString() == "Evidencija prisustva" ? "active" : "")">
                Evidencija prisustva
            </a>

            <div class="sidebar-section">Ostalo</div>
            <a asp-controller="Profesor" asp-action="ZahtjevZaDokument"
               class="@(ViewData["Title"]?.ToString() == "Zahtjev za dokument" ? "active" : "")">
                Zahtjev za dokument
            </a>
            <a asp-controller="Profesor" asp-action="SlanjeNotifikacija"
               class="@(ViewData["Title"]?.ToString() == "Slanje notifikacija" ? "active" : "")">
                Slanje notifikacija
            </a>
        </div>

        <div class="content-area">
            @if (TempData["Uspjeh"] != null)
            {
                <div class="alert alert-success mb-3">✓ @TempData["Uspjeh"]</div>
            }
            @if (TempData["Greska"] != null)
            {
                <div class="alert alert-danger mb-3">✗ @TempData["Greska"]</div>
            }

            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
