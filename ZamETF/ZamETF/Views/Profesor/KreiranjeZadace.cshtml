@{
    ViewData["Title"] = "Kreiranje zadace";
    Layout = "~/Views/Profesor/_LayoutProfesor.cshtml";
    var predmeti = ViewBag.Predmeti as List<ZamETF.Models.Predmet>;
    var odabraniPredmetId = ViewBag.OdabraniPredmetId as int?;
}

<style>
    .forma-layout {
        display: flex;
        gap: 20px;
    }

    .forma-left {
        flex: 1;
    }

    .forma-right {
        width: 260px;
        min-width: 260px;
    }

    .panel {
        background: linear-gradient(145deg, #b8c8f8 0%, #c8e8c8 100%);
        border-radius: 15px;
        padding: 24px;
        color: #0f1535;
    }

    .panel-header {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 20px;
        text-align: center;
        color: #0f1535;
    }

    .predmet-odabir {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .predmet-btn {
        background: rgba(255,255,255,0.5);
        border: 1.5px solid rgba(30,58,138,0.2);
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        text-align: left;
        color: #1e3a8a;
        font-weight: 600;
        font-size: 0.88rem;
        transition: all 0.2s;
        width: 100%;
    }

        .predmet-btn:hover {
            background: rgba(255,255,255,0.8);
        }

        .predmet-btn.selected {
            background: #1e3a8a;
            color: white;
            border-color: #1e3a8a;
        }

        .predmet-btn .sifra {
            font-size: 0.72rem;
            opacity: 0.6;
            display: block;
        }

        .predmet-btn.selected .sifra {
            opacity: 0.8;
        }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #1e3a8a;
        margin-bottom: 5px;
        display: block;
    }

    .form-input {
        border: 1.5px solid rgba(30,58,138,0.25);
        border-radius: 9px;
        padding: 9px 13px;
        font-size: 0.9rem;
        color: #0f1535;
        background: rgba(255,255,255,0.65);
        width: 100%;
        outline: none;
        margin-bottom: 14px;
    }

        .form-input:focus {
            border-color: #3b82f6;
            background: rgba(255,255,255,0.85);
        }

    .btn-kreiraj {
        width: 100%;
        padding: 11px;
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        border: none;
        border-radius: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 4px;
    }

        .btn-kreiraj:hover {
            opacity: 0.88;
        }

    /* DESNA - pregled postojecih */
    .zadaca-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid rgba(15,21,53,0.08);
    }

        .zadaca-item:last-child {
            border-bottom: none;
        }

    .zadaca-naziv {
        font-weight: 600;
        font-size: 0.84rem;
        color: #0f1535;
    }

    .zadaca-info {
        font-size: 0.72rem;
        color: rgba(15,21,53,0.5);
        margin-top: 2px;
    }

    .rok-aktivan {
        color: #16a34a;
        font-weight: 600;
    }

    .rok-istekao {
        color: #dc2626;
    }

    .btn-link {
        color: #1e3a8a;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-link:hover {
            text-decoration: underline;
        }

    .empty-state {
        color: rgba(15,21,53,0.4);
        font-size: 0.84rem;
        padding: 8px 0;
    }

    .info-box {
        background: rgba(30,58,138,0.07);
        border-left: 3px solid #1a5f7a;
        border-radius: 8px;
        padding: 10px 13px;
        font-size: 0.82rem;
        color: #1e3a8a;
        margin-bottom: 16px;
    }
</style>

<div class="forma-layout">
    <div class="forma-left">
        <div class="panel">
            <div class="panel-header">Kreiranje nove zadace</div>

            <form method="post" asp-controller="Profesor" asp-action="KreiranjeZadace" id="formaZadaca">
                @Html.AntiForgeryToken()
                <input type="hidden" name="predmetId" id="predmetIdInput"
                       value="@(odabraniPredmetId?.ToString() ?? "")" />

                <label class="form-label">Odaberi predmet *</label>
                <div class="predmet-odabir">
                    @if (predmeti != null)
                    {
                        foreach (var p in predmeti)
                        {
                            var selected = odabraniPredmetId == p.Id;
                            <button type="button"
                                    class="predmet-btn @(selected ? "selected" : "")"
                                    id="predmetBtn@(p.Id)"
                                    onclick="odaberiPredmet(@p.Id, this)">
                                <span class="sifra">@p.SifraPredmeta</span>
                                @p.Naziv
                            </button>
                        }
                    }
                </div>

                <label class="form-label">Naziv zadace *</label>
                <input type="text" name="nazividID" class="form-input"
                       placeholder="Npr. Zadaca 1 - Osnove OOP-a" required maxlength="50" />

                <label class="form-label">Opis zadace</label>
                <textarea name="opis" class="form-input" rows="4"
                          placeholder="Opisite sta studenti trebaju uraditi..." maxlength="2000"></textarea>

                <label class="form-label">Rok predaje *</label>
                <input type="datetime-local" name="rok" class="form-input" required />

                <label class="form-label">Maksimalni bodovi <span style="color:#dc2626;">*</span></label>
                <input type="number" name="maxBodovi" class="form-input"
                       min="1" max="100" value="100" required />

                <button type="submit" class="btn-kreiraj">Kreiraj zadacu</button>
            </form>
        </div>
    </div>

    <div class="forma-right">
        <div class="panel">
            <div class="panel-header" style="font-size:0.9rem;">Postojece zadace</div>
            <div id="zadacePrikaz">
                @if (predmeti != null)
                {
                    foreach (var p in predmeti)
                    {
                        <div id="zadaceGrupa@(p.Id)"
                             style="@(odabraniPredmetId == p.Id ? "" : "display:none;")">
                            <div style="font-size:0.78rem; font-weight:700; color:rgba(30,58,138,0.6); margin-bottom:8px; text-transform:uppercase;">@p.Naziv</div>
                            @if (p.Zadace != null && p.Zadace.Any())
                            {
                                foreach (var z in p.Zadace.OrderByDescending(z2 => z2.Rok))
                                {
                                    var istekao = !z.ProvjeriRok();
                                    <div class="zadaca-item">
                                        <div>
                                            <div class="zadaca-naziv">@z.NazivID</div>
                                            <div class="zadaca-info @(istekao ? "rok-istekao" : "rok-aktivan")">
                                                @z.Rok.ToString("dd.MM.yyyy")
                                            </div>
                                        </div>
                                        <a asp-controller="Profesor" asp-action="OcjenjivanjeZadace"
                                           asp-route-id="@z.Id" class="btn-link">Ocijeni</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="empty-state">Nema zadaca.</p>
                            }
                        </div>
                    }
                }
                <p class="empty-state" id="odaberiInfo"
                   style="@(odabraniPredmetId.HasValue ? "display:none;" : "")">
                    Odaberi predmet za prikaz zadaca.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function odaberiPredmet(id, btn) {
            document.querySelectorAll('.predmet-btn').forEach(function(b) { b.classList.remove('selected'); });
            btn.classList.add('selected');
            document.getElementById('predmetIdInput').value = id;

            document.querySelectorAll('[id^="zadaceGrupa"]').forEach(function(el) { el.style.display = 'none'; });
            var grupa = document.getElementById('zadaceGrupa' + id);
            if (grupa) grupa.style.display = 'block';

            var info = document.getElementById('odaberiInfo');
            if (info) info.style.display = 'none';
        }
    </script>
}
