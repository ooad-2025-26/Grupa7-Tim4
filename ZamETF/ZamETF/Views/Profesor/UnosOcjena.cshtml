@model ZamETF.ViewModels.UnosOcjenaVM
@{
    ViewData["Title"] = "Unos ocjena";
    Layout = "~/Views/Profesor/_LayoutProfesor.cshtml";
}

<style>
    .panel {
        background: linear-gradient(145deg, #b8c8f8 0%, #c8e8c8 100%);
        border-radius: 15px;
        padding: 24px;
        color: #0f1535;
        margin-bottom: 20px;
    }

    .panel-header {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 16px;
        color: #0f1535;
        padding-bottom: 8px;
        border-bottom: 1.5px solid rgba(30,58,138,0.12);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .back-link {
        color: #1e3a8a;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        opacity: 0.7;
    }

        .back-link:hover {
            opacity: 1;
        }

    .tabela {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tabela th {
            background: rgba(30,58,138,0.1);
            color: #1e3a8a;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 9px 10px;
            text-align: center;
            border-bottom: 2px solid rgba(30,58,138,0.15);
        }

            .tabela th.left {
                text-align: left;
            }

        .tabela td {
            padding: 8px 10px;
            border-bottom: 1px solid rgba(15,21,53,0.07);
            color: #0f1535;
            text-align: center;
            vertical-align: middle;
        }

            .tabela td.left {
                text-align: left;
            }

        .tabela tr:last-child td {
            border-bottom: none;
        }

        .tabela tr:hover td {
            background: rgba(255,255,255,0.3);
        }

    .input-bod {
        width: 65px;
        padding: 4px 7px;
        background: rgba(255,255,255,0.7);
        border: 1.5px solid rgba(30,58,138,0.2);
        border-radius: 7px;
        font-size: 0.85rem;
        color: #0f1535;
        text-align: center;
    }

    .input-ocjena {
        width: 65px;
        padding: 4px 7px;
        background: rgba(255,255,255,0.85);
        border: 2px solid #1e3a8a;
        border-radius: 7px;
        font-size: 0.88rem;
        font-weight: 700;
        color: #1e3a8a;
        text-align: center;
    }

    .ukupno-badge {
        display: inline-block;
        background: rgba(30,58,138,0.1);
        color: #1e3a8a;
        border-radius: 8px;
        padding: 3px 10px;
        font-weight: 700;
        font-size: 0.85rem;
        min-width: 40px;
        text-align: center;
    }

    .ocjena-auto {
        display: inline-block;
        background: rgba(22,163,74,0.1);
        color: #16a34a;
        border-radius: 8px;
        padding: 3px 10px;
        font-weight: 700;
        font-size: 0.85rem;
        min-width: 30px;
        text-align: center;
    }

    .ocjena-pao {
        background: rgba(220,38,38,0.1) !important;
        color: #dc2626 !important;
    }

    .btn-sacuvaj {
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 30px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-sacuvaj:hover {
            opacity: 0.88;
        }

    .btn-sacuvaj-ocjena {
        background: linear-gradient(90deg, #16a34a, #22c55e);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 30px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-sacuvaj-ocjena:hover {
            opacity: 0.88;
        }

    .sekcija-title {
        font-size: 0.72rem;
        font-weight: 700;
        color: rgba(30,58,138,0.5);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .alert-ok {
        background: #d4edda;
        color: #155724;
        border-radius: 10px;
        padding: 10px 15px;
        margin-bottom: 15px;
        font-size: 0.88rem;
    }

    .finalna-badge {
        display: inline-block;
        background: rgba(22,163,74,0.15);
        color: #16a34a;
        border-radius: 8px;
        padding: 3px 10px;
        font-weight: 700;
        font-size: 0.88rem;
    }
</style>

@if (TempData["Uspjeh"] != null)
{
    <div class="alert-ok">✓ @TempData["Uspjeh"]</div>
}

@if (!Model.Studenti.Any())
{
    <div class="panel">
        <p style="color:rgba(15,21,53,0.4); font-size:0.88rem;">Nema upisanih studenata.</p>
    </div>
}
else
{
    <!-- FORMA 1: Bodovi iz ispita -->
    <div class="panel">
        <div class="panel-header">
            <span>Bodovi iz ispita — @Model.Predmet.Naziv</span>
            <a asp-controller="Profesor" asp-action="DetaljiPredmeta"
               asp-route-id="@Model.Predmet.Id" class="back-link">
                &larr; Nazad na predmet
            </a>
        </div>

        <form asp-action="SacuvajBodovanjeIspit" asp-controller="Profesor" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="predmetId" value="@Model.Predmet.Id" />

            <table class="tabela">
                <thead>
                    <tr>
                        <th class="left">Student</th>
                        <th class="left">Indeks</th>
                        <th class="sekcija-title">Parcijalni</th>
                        <th class="sekcija-title">Završni</th>
                        <th class="sekcija-title">Integralni</th>
                        <th class="sekcija-title">Teorija</th>
                        <th class="sekcija-title">Zadaće</th>
                        <th class="sekcija-title">Ukupno</th>
                        <th class="sekcija-title">Auto ocjena</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Studenti)
                    {
                        var ukupno = s.UkupnoBodova;
                        var autoOcjena = ukupno < 55 ? 5 : ukupno < 65 ? 6 : ukupno < 75 ? 7 : ukupno < 85 ? 8 : ukupno < 95 ? 9 : 10;
                        <tr>
                            <td class="left"><strong>@s.ImePrezime</strong></td>
                            <td class="left">@s.Indeks</td>
                            <td>
                                <input type="hidden" name="studentId" value="@s.StudentId" />
                                <input type="number" name="bodoviParcijalni" min="0" max="100"
                                       value="@(s.BodoviParcijalni?.ToString() ?? "")"
                                       class="input-bod" id="par-@s.StudentId"
                                       oninput="izracunaj(@s.StudentId)" />
                            </td>
                            <td>
                                <input type="number" name="bodoviZavrsni" min="0" max="100"
                                       value="@(s.BodoviZavrsni?.ToString() ?? "")"
                                       class="input-bod" id="zav-@s.StudentId"
                                       oninput="izracunaj(@s.StudentId)" />
                            </td>
                            <td>
                                <input type="number" name="bodoviIntegralni" min="0" max="100"
                                       value="@(s.BodoviIntegralni?.ToString() ?? "")"
                                       class="input-bod" id="int-@s.StudentId"
                                       oninput="izracunaj(@s.StudentId)" />
                            </td>
                            <td>
                                <input type="number" name="bodoviTeorija" min="0" max="100"
                                       value="@(s.BodoviTeorija?.ToString() ?? "")"
                                       class="input-bod" id="teo-@s.StudentId"
                                       oninput="izracunaj(@s.StudentId)" />
                            </td>
                            <td>
                                <span class="ukupno-badge" id="zad-@s.StudentId">
                                    @s.BodoviZadace
                                </span>
                            </td>
                            <td>
                                <span class="ukupno-badge" id="ukupno-@s.StudentId">
                                    @ukupno
                                </span>
                            </td>
                            <td>
                                <span class="ocjena-auto @(autoOcjena < 6 ? "ocjena-pao" : "")"
                                      id="auto-@s.StudentId">
                                    @autoOcjena
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="text-align:right; margin-top:16px;">
                <button type="submit" class="btn-sacuvaj">Sačuvaj bodove iz ispita</button>
            </div>
        </form>
    </div>

    <!-- FORMA 2: Finalne ocjene -->
    <div class="panel">
        <div class="panel-header">
            <span>Finalne ocjene — @Model.Predmet.Naziv</span>
        </div>
        <p style="font-size:0.82rem; color:rgba(15,21,53,0.55); margin-bottom:14px;">
            Ocjena se automatski računa iz ukupnih bodova. Možete je ručno promijeniti prije snimanja.
        </p>

        <form asp-action="SacuvajFinalneOcjene" asp-controller="Profesor" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="predmetId" value="@Model.Predmet.Id" />

            <table class="tabela">
                <thead>
                    <tr>
                        <th class="left">Student</th>
                        <th class="left">Indeks</th>
                        <th class="sekcija-title">Ukupno bodova</th>
                        <th class="sekcija-title">Auto ocjena</th>
                        <th class="sekcija-title">Finalna ocjena</th>
                        <th class="sekcija-title">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Studenti)
                    {
                        var ukupno = s.UkupnoBodova;
                        var autoOcjena = ukupno < 55 ? 5 : ukupno < 65 ? 6 : ukupno < 75 ? 7 : ukupno < 85 ? 8 : ukupno < 95 ? 9 : 10;
                        <tr>
                            <td class="left"><strong>@s.ImePrezime</strong></td>
                            <td class="left">@s.Indeks</td>
                            <td>
                                <span class="ukupno-badge">@ukupno</span>
                            </td>
                            <td>
                                <span class="ocjena-auto @(autoOcjena < 6 ? "ocjena-pao" : "")">
                                    @autoOcjena
                                </span>
                            </td>
                            <td>
                                <input type="hidden" name="studentId" value="@s.StudentId" />
                                <input type="number" name="finalnaOcjena" min="5" max="10"
                                       value="@(s.FinalnaOcjena?.ToString() ?? autoOcjena.ToString())"
                                       class="input-ocjena" />
                            </td>
                            <td>
                                @if (s.FinalnaOcjena.HasValue)
                                {
                                    <span class="finalna-badge">✓ Unesena</span>
                                }
                                else
                                {
                                    <span style="color:rgba(15,21,53,0.35); font-size:0.8rem;">Nije unesena</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="text-align:right; margin-top:16px;">
                <button type="submit" class="btn-sacuvaj-ocjena">Sačuvaj finalne ocjene</button>
            </div>
        </form>
    </div>
}

@section Scripts {
    <script>
        function izracunaj(sid) {
            var par = parseInt(document.getElementById('par-' + sid)?.value) || 0;
            var zav = parseInt(document.getElementById('zav-' + sid)?.value) || 0;
            var int_ = parseInt(document.getElementById('int-' + sid)?.value) || 0;
            var teo = parseInt(document.getElementById('teo-' + sid)?.value) || 0;
            var zad = parseInt(document.getElementById('zad-' + sid)?.textContent) || 0;

            var ukupno = Math.min(par + zav + int_ + teo + zad, 100);

            document.getElementById('ukupno-' + sid).textContent = ukupno;

            var o = ukupno < 55 ? 5 : ukupno < 65 ? 6 : ukupno < 75 ? 7 : ukupno < 85 ? 8 : ukupno < 95 ? 9 : 10;
            var autoEl = document.getElementById('auto-' + sid);
            autoEl.textContent = o;
            if (ukupno < 55) autoEl.classList.add('ocjena-pao');
            else autoEl.classList.remove('ocjena-pao');
        }
    </script>
}