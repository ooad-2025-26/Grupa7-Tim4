@{
    ViewData["Title"] = "Kreiranje ispita";
    Layout = "~/Views/Profesor/_LayoutProfesor.cshtml";
    var predmeti = ViewBag.Predmeti as List<ZamETF.Models.Predmet>;
    var odabraniPredmetId = ViewBag.OdabraniPredmetId as int?;
    var ispiti = ViewBag.Ispiti as List<ZamETF.Models.Ispit>;
}

<style>
    .forma-layout {
        display: flex;
        gap: 20px;
    }

    .forma-left {
        flex: 1;
    }

    .forma-right {
        width: 260px;
        min-width: 260px;
    }

    .panel {
        background: linear-gradient(145deg, #b8c8f8 0%, #c8e8c8 100%);
        border-radius: 15px;
        padding: 24px;
        color: #0f1535;
    }

    .panel-header {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .predmet-odabir {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .predmet-btn {
        background: rgba(255,255,255,0.5);
        border: 1.5px solid rgba(30,58,138,0.2);
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        text-align: left;
        color: #1e3a8a;
        font-weight: 600;
        font-size: 0.88rem;
        transition: all 0.2s;
        width: 100%;
    }

        .predmet-btn:hover {
            background: rgba(255,255,255,0.8);
        }

        .predmet-btn.selected {
            background: #1e3a8a;
            color: white;
            border-color: #1e3a8a;
        }

        .predmet-btn .sifra {
            font-size: 0.72rem;
            opacity: 0.6;
            display: block;
        }

        .predmet-btn.selected .sifra {
            opacity: 0.8;
        }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #1e3a8a;
        margin-bottom: 5px;
        display: block;
    }

    .form-input {
        border: 1.5px solid rgba(30,58,138,0.25);
        border-radius: 9px;
        padding: 9px 13px;
        font-size: 0.9rem;
        color: #0f1535;
        background: rgba(255,255,255,0.65);
        width: 100%;
        outline: none;
        margin-bottom: 14px;
    }

        .form-input:focus {
            border-color: #3b82f6;
            background: rgba(255,255,255,0.85);
        }

    .forma-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

        .forma-grid .forma-group {
            display: flex;
            flex-direction: column;
        }

            .forma-grid .forma-group .form-input {
                margin-bottom: 0;
            }

    .btn-kreiraj {
        width: 100%;
        padding: 11px;
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        border: none;
        border-radius: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 14px;
    }

        .btn-kreiraj:hover {
            opacity: 0.88;
        }

    .ispit-item {
        padding: 9px 0;
        border-bottom: 1px solid rgba(15,21,53,0.08);
    }

        .ispit-item:last-child {
            border-bottom: none;
        }

    .ispit-datum {
        font-weight: 700;
        font-size: 0.86rem;
        color: #0f1535;
    }

    .ispit-info {
        font-size: 0.73rem;
        color: rgba(15,21,53,0.5);
        margin-top: 2px;
    }

    .ispit-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 5px;
    }

    .prijave-badge {
        background: rgba(142,68,173,0.1);
        color: #8e44ad;
        border-radius: 8px;
        padding: 2px 8px;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .btn-link {
        color: #1e3a8a;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-link:hover {
            text-decoration: underline;
        }

    .rok-aktivan {
        color: #16a34a;
        font-weight: 600;
    }

    .rok-istekao {
        color: #dc2626;
    }

    .empty-state {
        color: rgba(15,21,53,0.4);
        font-size: 0.84rem;
        padding: 8px 0;
    }

    .info-box {
        background: rgba(142,68,173,0.08);
        border-left: 3px solid #8e44ad;
        border-radius: 8px;
        padding: 10px 13px;
        font-size: 0.82rem;
        color: #6c3483;
        margin-bottom: 16px;
    }
</style>

<div class="forma-layout">
    <div class="forma-left">
        <div class="panel">
            <div class="panel-header">Kreiranje novog ispita</div>

            <div class="info-box">
                Nakon kreiranja, studenti ce moci prijaviti ispit putem svog panela u zadatom roku za prijavu.
            </div>

            <form method="post" asp-controller="Profesor" asp-action="KreiranjeIspita" id="formaIspit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="predmetId" id="predmetIdInput"
                       value="@(odabraniPredmetId?.ToString() ?? "")" />

                <label class="form-label">Odaberi predmet *</label>
                <div class="predmet-odabir">
                    @if (predmeti != null)
                    {
                        foreach (var p in predmeti)
                        {
                            var selected = odabraniPredmetId == p.Id;
                            <button type="button"
                                    class="predmet-btn @(selected ? "selected" : "")"
                                    id="predmetBtn@(p.Id)"
                                    onclick="odaberiPredmet(@p.Id, this)">
                                <span class="sifra">@p.SifraPredmeta</span>
                                @p.Naziv
                            </button>
                        }
                    }
                </div>

                <div class="forma-grid" style="margin-bottom:14px;">
                    <div class="forma-group">
                        <label class="form-label">Datum ispita *</label>
                        <input type="datetime-local" name="datum" class="form-input" required />
                    </div>
                    <div class="forma-group">
                        <label class="form-label">Rok za prijavu *</label>
                        <input type="date" name="rokZaPrijavu" class="form-input" required />
                    </div>
                </div>

                <button type="submit" class="btn-kreiraj">Kreiraj ispit</button>
            </form>
        </div>
    </div>

    <div class="forma-right">
        <div class="panel">
            <div class="panel-header" style="font-size:0.9rem;">Postojeci ispiti</div>
            <div id="ispitiPrikaz">
                @if (predmeti != null)
                {
                    foreach (var p in predmeti)
                    {
                        var ispitiPredmeta = ispiti?.Where(i => i.Predmet?.Id == p.Id).ToList() ?? new List<ZamETF.Models.Ispit>();
                        <div id="ispitiGrupa@(p.Id)"
                             style="@(odabraniPredmetId == p.Id ? "" : "display:none;")">
                            <div style="font-size:0.78rem; font-weight:700; color:rgba(30,58,138,0.6); margin-bottom:8px; text-transform:uppercase;">@p.Naziv</div>
                            @if (ispitiPredmeta.Any())
                            {
                                foreach (var ispit in ispitiPredmeta.OrderByDescending(i2 => i2.Datum))
                                {
                                    var rokIstekao = !ispit.ProvjeriRokZaPrijavu();
                                    <div class="ispit-item">
                                        <div class="ispit-datum">@ispit.Datum.ToString("dd.MM.yyyy HH:mm")</div>
                                        <div class="ispit-info @(rokIstekao ? "rok-istekao" : "rok-aktivan")">
                                            Rok prijave: @ispit.RokZaPrijavu.ToString("dd.MM.yyyy")
                                        </div>
                                        <div class="ispit-footer">
                                            <span class="prijave-badge">@(ispit.Prijave?.Count ?? 0) prijava</span>
                                            <a asp-controller="Profesor" asp-action="DetaljiIspita"
                                               asp-route-id="@ispit.Id" class="btn-link">Detalji</a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="empty-state">Nema ispita.</p>
                            }
                        </div>
                    }
                }
                <p class="empty-state" id="odaberiInfo"
                   style="@(odabraniPredmetId.HasValue ? "display:none;" : "")">
                    Odaberi predmet za prikaz ispita.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function odaberiPredmet(id, btn) {
            document.querySelectorAll('.predmet-btn').forEach(function(b) { b.classList.remove('selected'); });
            btn.classList.add('selected');
            document.getElementById('predmetIdInput').value = id;
            document.querySelectorAll('[id^="ispitiGrupa"]').forEach(function(el) { el.style.display = 'none'; });
            var grupa = document.getElementById('ispitiGrupa' + id);
            if (grupa) grupa.style.display = 'block';
            var info = document.getElementById('odaberiInfo');
            if (info) info.style.display = 'none';
        }
    </script>
}
